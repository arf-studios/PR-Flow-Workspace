                e.preventDefault();
                const ownerId = document.getElementById('nc-owner-id').value;
                const todayStr = new Date().toISOString().slice(0, 10);
                const created = Store.createContent({
                    campaignId: document.getElementById('nc-campaign-id').value,
                    ownerId,
                    title: document.getElementById('nc-title').value.trim(),
                    phase: Number(document.getElementById('nc-phase').value) || 1,
                    research: {
                        audience: 'Publik & Media Nasional',
                        trends: 'Tren industri terkini',
                        issueAudit: 'Belum ada catatan risiko khusus.',
                        issueRisk: document.getElementById('nc-risk').value,
                        funnel: document.getElementById('nc-funnel').value,
                        kpiMetric: 'Impressions / Reach',
                        kpiTarget: 50000,
                        pillar: document.getElementById('nc-pillar').value.trim() || 'Reputasi Korporasi',
                        peso: document.getElementById('nc-peso').value,
                        competitorNotes: '-',
                        format: 'Artikel + Konten Visual'
                    },
                    planning: {
                        brief: 'Lengkapi creative brief di sini.',
                        outline: '1. Hook\n2. Pesan Utama\n3. CTA',
                        needsBriefRevision: false,
                        briefRevisionNote: '',
                        takeDate: todayStr,
                        publishDate: todayStr,
                        publishTime: '19:00',
                        crewIds: ownerId ? [ownerId] : [],
                        location: 'Kantor Pusat Jakarta',
                        travelEstimate: '15 menit',
                        gcalSynced: false,
                        gdriveGenerated: false
                    },
                    production: {
                        stage: 'pra_produksi',
                        preProdChecklist: { kamera: false, audio: false, lighting: false, briefingMeet: false },
                        qcChecklist: { visualAudio: false, tonePR: false, brandSafety: false, akurasiData: false },
                        revisions: []
                    },
                    distribution: {
                        channels: ['Instagram', 'LinkedIn'],
                        published: false,
                        sentiment: { positive: 0, neutral: 0, negative: 0 },
                        mentions: 0,
                        responseStatus: 'Belum Direspon'
                    },
                    evaluation: { kpiActual: 0, auditCause: '', auditNotes: '', actionTaken: '', archived: false }
                });

                this.closeModal('new-content-modal');
                this.showToast('success', 'Konten Baru Dibuat', `"${created.title}" siap dikelola.`);
                this.openDetailDrawer(created.id, created.phase);
            },

            openCampaignModal() {
                document.getElementById('entity-modal-box').innerHTML = `
