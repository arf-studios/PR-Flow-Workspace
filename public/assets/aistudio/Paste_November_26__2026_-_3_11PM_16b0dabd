<!DOCTYPE html>
<html lang="id" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PRFlow Workspace Pro — Content Planner & PR Digital Archive</title>

    <!-- Google Fonts: Plus Jakarta Sans & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">

    <!-- Tailwind CSS v3 CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['Plus Jakarta Sans', 'Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            200: '#c7d2fe',
                            300: '#a5b4fc',
                            400: '#818cf8',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            800: '#3730a3',
                            900: '#312e81',
                            950: '#1e1b4b'
                        }
                    },
                    boxShadow: {
                        soft: '0 2px 10px -2px rgba(15, 23, 42, 0.06), 0 1px 3px -1px rgba(15, 23, 42, 0.04)',
                        elevated: '0 12px 32px -8px rgba(15, 23, 42, 0.14)'
                    }
                }
            }
        }
    </script>

    <!-- Lucide Icons CDN -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <style>
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(148, 163, 184, 0.35); border-radius: 9999px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(100, 116, 139, 0.6); }

        .kanban-col { min-height: 440px; }
        .drag-over {
            border-color: #6366f1 !important;
            background-color: rgba(99, 102, 241, 0.07) !important;
        }
        @keyframes fadeSlideUp {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-view { animation: fadeSlideUp 0.22s ease-out; }
        .spinner {
            border: 2px solid rgba(255,255,255,0.3);
            border-top-color: currentColor;
            border-radius: 50%;
            width: 14px;
            height: 14px;
            animation: spin 0.65s linear infinite;
            display: inline-block;
        }
        @keyframes spin { to { transform: rotate(360deg); } }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-100 font-sans antialiased selection:bg-brand-500 selection:text-white overflow-hidden">

    <!-- ================= APP SHELL ================= -->
    <div class="flex h-screen overflow-hidden">

        <!-- Mobile Sidebar Backdrop -->
        <div id="sidebar-backdrop" onclick="UI.toggleMobileSidebar(false)" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-40 hidden lg:hidden transition-opacity"></div>

        <!-- ================= SIDEBAR NAVIGASI ================= -->
        <aside id="sidebar" class="fixed lg:static inset-y-0 left-0 z-50 w-72 bg-white dark:bg-slate-900 border-r border-slate-200/80 dark:border-slate-800 flex flex-col transform -translate-x-full lg:translate-x-0 transition-transform duration-200 ease-in-out shrink-0">

            <!-- Brand Header -->
            <div class="h-16 px-5 flex items-center justify-between border-b border-slate-200/80 dark:border-slate-800">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-brand-600 via-indigo-600 to-violet-600 flex items-center justify-center text-white shadow-md shadow-brand-500/25">
                        <i data-lucide="layers" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <div class="flex items-center gap-1.5">
                            <h1 class="font-display font-bold text-sm tracking-tight text-slate-900 dark:text-white leading-none">PRFlow Pro</h1>
                            <span class="px-1.5 py-0.5 text-[9px] font-bold uppercase rounded bg-brand-100 text-brand-700 dark:bg-brand-950 dark:text-brand-300">v2.0</span>
                        </div>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400 font-medium mt-0.5">PR Agency Workspace</p>
                    </div>
                </div>
                <button onclick="UI.toggleMobileSidebar(false)" class="lg:hidden p-1.5 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- Navigation Links -->
            <nav class="flex-1 overflow-y-auto p-3 space-y-1">
                <div class="px-3 pt-1 pb-1 text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Utama</div>

                <button onclick="UI.navigateTo('dashboard')" data-nav="dashboard" class="nav-item w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium transition-all">
                    <span class="flex items-center gap-3">
                        <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
                        Dashboard & Pipeline
                    </span>
                </button>

                <div class="px-3 pt-4 pb-1 text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">5 Fase Alur Kerja PR</div>

                <button onclick="UI.navigateTo('phase1')" data-nav="phase1" class="nav-item w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium transition-all">
                    <span class="flex items-center gap-3 min-w-0">
                        <i data-lucide="compass" class="w-4 h-4 text-fuchsia-500 shrink-0"></i>
                        <span class="truncate">1. Riset & PESO</span>
                    </span>
                    <span id="badge-phase1" class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">0</span>
                </button>

                <button onclick="UI.navigateTo('phase2')" data-nav="phase2" class="nav-item w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium transition-all">
                    <span class="flex items-center gap-3 min-w-0">
                        <i data-lucide="calendar-days" class="w-4 h-4 text-cyan-500 shrink-0"></i>
                        <span class="truncate">2. Planner & Kalender</span>
                    </span>
                    <span id="badge-phase2" class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">0</span>
                </button>

                <button onclick="UI.navigateTo('phase3')" data-nav="phase3" class="nav-item w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium transition-all">
                    <span class="flex items-center gap-3 min-w-0">
                        <i data-lucide="clapperboard" class="w-4 h-4 text-amber-500 shrink-0"></i>
                        <span class="truncate">3. Produksi & QC</span>
                    </span>
                    <span id="badge-phase3" class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">0</span>
                </button>

                <button onclick="UI.navigateTo('phase4')" data-nav="phase4" class="nav-item w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium transition-all">
                    <span class="flex items-center gap-3 min-w-0">
                        <i data-lucide="radio" class="w-4 h-4 text-sky-500 shrink-0"></i>
                        <span class="truncate">4. Distribusi & Monitor</span>
                    </span>
                    <span id="badge-phase4" class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">0</span>
                </button>

                <button onclick="UI.navigateTo('phase5')" data-nav="phase5" class="nav-item w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium transition-all">
                    <span class="flex items-center gap-3 min-w-0">
                        <i data-lucide="bar-chart-3" class="w-4 h-4 text-emerald-500 shrink-0"></i>
                        <span class="truncate">5. Evaluasi & Krisis</span>
                    </span>
                    <span id="badge-phase5" class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">0</span>
                </button>

                <div class="px-3 pt-4 pb-1 text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Manajemen & Repositori</div>

                <button onclick="UI.navigateTo('campaigns')" data-nav="campaigns" class="nav-item w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium transition-all">
                    <span class="flex items-center gap-3 min-w-0">
                        <i data-lucide="briefcase" class="w-4 h-4 text-indigo-500 shrink-0"></i>
                        <span class="truncate">Kampanye & Tim Kru</span>
                    </span>
                    <span id="badge-campaigns" class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">0</span>
                </button>

                <button onclick="UI.navigateTo('assets')" data-nav="assets" class="nav-item w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium transition-all">
                    <span class="flex items-center gap-3 min-w-0">
                        <i data-lucide="folder-kanban" class="w-4 h-4 text-blue-500 shrink-0"></i>
                        <span class="truncate">Aset Digital (DAM)</span>
                    </span>
                    <span id="badge-assets" class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">0</span>
                </button>

                <button onclick="UI.navigateTo('archive')" data-nav="archive" class="nav-item w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium transition-all">
                    <span class="flex items-center gap-3 min-w-0">
                        <i data-lucide="archive" class="w-4 h-4 text-slate-500 shrink-0"></i>
                        <span class="truncate">Arsip Pembelajaran</span>
                    </span>
                    <span id="badge-archive" class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">0</span>
                </button>

                <button onclick="UI.navigateTo('settings')" data-nav="settings" class="nav-item w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium transition-all">
                    <span class="flex items-center gap-3 min-w-0">
                        <i data-lucide="plug-zap" class="w-4 h-4 text-violet-500 shrink-0"></i>
                        <span class="truncate">Integrasi & Backup</span>
                    </span>
                </button>
            </nav>

            <!-- Sidebar Sync Status & Footer -->
            <div class="p-3 border-t border-slate-200/80 dark:border-slate-800 space-y-2">
                <div id="sync-status-pill" class="px-3 py-2 rounded-xl bg-slate-50 dark:bg-slate-950/70 border border-slate-200/80 dark:border-slate-800 flex items-center justify-between text-[11px]">
                    <span class="flex items-center gap-2 font-medium text-slate-600 dark:text-slate-300">
                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                        LocalDB Tersimpan
                    </span>
                    <span id="sync-last-time" class="text-slate-400">Aktif</span>
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <button onclick="Integrations.exportCSV()" class="flex items-center justify-center gap-1.5 px-2.5 py-2 rounded-xl text-xs font-semibold bg-emerald-50 text-emerald-700 hover:bg-emerald-100 dark:bg-emerald-950/50 dark:text-emerald-300 border border-emerald-200/70 dark:border-emerald-800/60 transition-colors">
                        <i data-lucide="file-spreadsheet" class="w-3.5 h-3.5"></i>
                        CSV
                    </button>
                    <button onclick="Integrations.exportJSON()" class="flex items-center justify-center gap-1.5 px-2.5 py-2 rounded-xl text-xs font-semibold bg-brand-50 text-brand-700 hover:bg-brand-100 dark:bg-brand-950/50 dark:text-brand-300 border border-brand-200/70 dark:border-brand-800/60 transition-colors">
                        <i data-lucide="download" class="w-3.5 h-3.5"></i>
                        JSON
                    </button>
                </div>
            </div>
        </aside>

        <!-- ================= MAIN WORKSPACE AREA ================= -->
        <div class="flex-1 flex flex-col min-w-0 overflow-hidden">

            <!-- TOP BAR -->
            <header class="h-16 bg-white/85 dark:bg-slate-900/85 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800 px-4 lg:px-6 flex items-center justify-between gap-3 shrink-0 z-30">

                <div class="flex items-center gap-3 flex-1 min-w-0">
                    <button onclick="UI.toggleMobileSidebar(true)" class="lg:hidden p-2 rounded-xl text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800">
                        <i data-lucide="menu" class="w-5 h-5"></i>
                    </button>

                    <!-- Global Search -->
                    <div class="relative flex-1 max-w-md">
                        <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                        <input id="global-search" type="text" oninput="UI.handleFilterChange()" placeholder="Cari konten, kampanye, kru, aset... (Ctrl+K)" class="w-full pl-10 pr-12 py-2 text-sm bg-slate-100/90 dark:bg-slate-800/80 border border-transparent focus:border-brand-500 focus:bg-white dark:focus:bg-slate-900 rounded-xl outline-none transition-all placeholder:text-slate-400">
                        <kbd class="hidden sm:inline-block absolute right-3 top-1/2 -translate-y-1/2 px-1.5 py-0.5 text-[10px] font-semibold text-slate-400 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded">⌘K</kbd>
                    </div>

                    <!-- Filter Kampanye Relasional -->
                    <div class="hidden md:block">
                        <select id="campaign-filter" onchange="UI.handleFilterChange()" class="text-sm bg-slate-100/90 dark:bg-slate-800/80 border border-transparent focus:border-brand-500 rounded-xl px-3 py-2 outline-none cursor-pointer text-slate-700 dark:text-slate-200 max-w-[220px]">
                            <option value="ALL">Semua Kampanye</option>
                        </select>
                    </div>
                </div>

                <!-- Right Controls -->
                <div class="flex items-center gap-2 shrink-0">
                    <!-- Notification Bell -->
                    <div class="relative">
                        <button id="notif-toggle-btn" onclick="UI.toggleNotifications()" class="relative p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors" title="Notifikasi & Audit Log">
                            <i data-lucide="bell" class="w-4 h-4"></i>
                            <span id="notif-dot" class="hidden absolute top-1.5 right-1.5 w-2.5 h-2.5 rounded-full bg-rose-500 ring-2 ring-white dark:ring-slate-900"></span>
                        </button>

                        <!-- Notification Dropdown -->
                        <div id="notif-panel" class="hidden absolute right-0 mt-2 w-80 sm:w-96 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-elevated z-50 overflow-hidden">
                            <div class="px-4 py-3 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
                                <span class="font-bold text-sm">Notifikasi & Log Aktivitas</span>
                                <button onclick="Store.markAllNotificationsRead()" class="text-xs text-brand-600 dark:text-brand-400 hover:underline font-semibold">Tandai dibaca</button>
                            </div>
                            <div id="notif-list" class="max-h-80 overflow-y-auto divide-y divide-slate-100 dark:divide-slate-800"></div>
                        </div>
                    </div>

                    <!-- Theme Toggle -->
                    <button onclick="UI.toggleTheme()" class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors" title="Ganti Tema Gelap/Terang">
                        <i id="theme-icon" data-lucide="moon" class="w-4 h-4"></i>
                    </button>

                    <!-- + Konten Baru -->
                    <button onclick="UI.openNewContentModal()" class="flex items-center gap-2 px-3.5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold shadow-sm shadow-brand-500/25 transition-all active:scale-95">
                        <i data-lucide="plus" class="w-4 h-4"></i>
                        <span class="hidden sm:inline">Konten Baru</span>
                    </button>
                </div>
            </header>

            <!-- DYNAMIC CONTENT VIEWPORT -->
            <main id="main-content" class="flex-1 overflow-y-auto p-4 lg:p-6 space-y-6"></main>
        </div>
    </div>

    <!-- ================= SLIDE-OVER DRAWER: EDITOR KONTEN LINTAS 5 FASE + DAM ================= -->
    <div id="detail-drawer-backdrop" onclick="UI.closeDetailDrawer()" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden transition-opacity"></div>
    <aside id="detail-drawer" class="fixed inset-y-0 right-0 z-50 w-full max-w-3xl bg-white dark:bg-slate-900 border-l border-slate-200 dark:border-slate-800 shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col">
        <div id="drawer-header" class="px-6 py-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between gap-4 shrink-0"></div>
        <div id="drawer-stepper" class="px-6 py-3 bg-slate-50 dark:bg-slate-950/60 border-b border-slate-200 dark:border-slate-800 shrink-0 overflow-x-auto"></div>
        <div id="drawer-tabs" class="px-6 border-b border-slate-200 dark:border-slate-800 flex items-center gap-1 overflow-x-auto shrink-0 bg-white dark:bg-slate-900"></div>
        <div id="drawer-body" class="flex-1 overflow-y-auto p-6 space-y-5"></div>
        <div id="drawer-footer" class="px-6 py-4 border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950/60 flex items-center justify-between gap-3 shrink-0"></div>
    </aside>

    <!-- ================= MODAL: TAMBAH KONTEN BARU ================= -->
    <div id="new-content-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm">
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
                <h3 class="font-display font-bold text-base flex items-center gap-2">
                    <i data-lucide="sparkles" class="w-4 h-4 text-brand-500"></i>
                    Buat Item Konten PR Baru
                </h3>
                <button onclick="UI.closeModal('new-content-modal')" class="p-1.5 rounded-lg text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            </div>
            <form id="new-content-form" onsubmit="UI.submitNewContent(event)" class="p-6 space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Judul Konten / Topik PR *</label>
                    <input id="nc-title" type="text" required placeholder="Contoh: Siaran Pers Peluncuran Program Beasiswa" class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 outline-none focus:border-brand-500">
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Kampanye (Relasional) *</label>
                        <select id="nc-campaign-id" required class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 outline-none focus:border-brand-500"></select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">PIC / Penanggung Jawab *</label>
                        <select id="nc-owner-id" required class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 outline-none focus:border-brand-500"></select>
                    </div>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Mulai Fase</label>
                        <select id="nc-phase" class="w-full px-3 py-2.5 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 outline-none focus:border-brand-500">
                            <option value="1">Fase 1: Riset</option>
                            <option value="2">Fase 2: Planner</option>
                            <option value="3">Fase 3: Produksi</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">PESO Model</label>
                        <select id="nc-peso" class="w-full px-3 py-2.5 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 outline-none focus:border-brand-500">
                            <option value="Earned">Earned Media</option>
                            <option value="Owned">Owned Media</option>
                            <option value="Shared">Shared Media</option>
                            <option value="Paid">Paid Media</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Funnel</label>
                        <select id="nc-funnel" class="w-full px-3 py-2.5 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 outline-none focus:border-brand-500">
                            <option value="Awareness">Awareness</option>
                            <option value="Engagement">Engagement</option>
                            <option value="Conversion">Conversion</option>
                        </select>
                    </div>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Content Pillar</label>
                        <input id="nc-pillar" type="text" value="Reputasi Korporasi" class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 outline-none focus:border-brand-500">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1.5">Level Risiko Isu</label>
                        <select id="nc-risk" class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 outline-none focus:border-brand-500">
