        /* =====================================================================
           MODULE 2: CLOUD ADAPTER & DATABASE SERVICE LAYER (SINGLE SOURCE OF TRUTH)
           ===================================================================== */
        const CloudAdapter = {
            /**
             * Tempat menyambungkan ke Supabase / Firebase REST atau SDK.
             * Contoh Supabase:
             *   fetch(`${cfg.supabaseUrl}/rest/v1/workspace_snapshots`, {
             *     method: 'POST', headers: { apikey: cfg.supabaseAnonKey, Authorization: `Bearer ${cfg.supabaseAnonKey}`, 'Content-Type': 'application/json' },
             *     body: JSON.stringify(payload)
             *   })
             */
            async syncToCloud(dbSnapshot) {
                const cfg = dbSnapshot.integrations;
                if (cfg.cloudProvider === 'supabase' && cfg.supabaseUrl && cfg.supabaseAnonKey) {
                    const res = await fetch(`${cfg.supabaseUrl.replace(/\/$/, '')}/rest/v1/prflow_state`, {
                        method: 'POST',
                        headers: {
                            'apikey': cfg.supabaseAnonKey,
                            'Authorization': `Bearer ${cfg.supabaseAnonKey}`,
                            'Content-Type': 'application/json',
                            'Prefer': 'resolution=merge-duplicates'
                        },
                        body: JSON.stringify({ id: 'primary_workspace', payload: dbSnapshot, updated_at: new Date().toISOString() })
                    });
                    if (!res.ok) throw new Error(`HTTP ${res.status}: Pastikan tabel prflow_state tersedia di Supabase.`);
                    return { ok: true, mode: 'Supabase Cloud' };
                }
                // Simulasi latensi adapter lokal agar UX sinkronisasi terasa nyata
                await new Promise(r => setTimeout(r, 450));
                return { ok: true, mode: 'LocalStorage Adapter (Ready for Cloud)' };
            },

            async sendWebhook(eventName, detailObj, integrationsCfg) {
                if (!integrationsCfg?.webhookUrl) return { simulated: true };
                try {
                    await fetch(integrationsCfg.webhookUrl, {
                        method: 'POST',
                        mode: 'no-cors',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            source: 'PRFlow Workspace Pro',
                            event: eventName,
                            timestamp: new Date().toISOString(),
                            data: detailObj
                        })
                    });
                    return { ok: true, simulated: false };
                } catch (err) {
                    console.warn('Webhook error:', err);
                    return { ok: false, error: err.message };
                }
            }
        };

        const Store = {
            state: null,
            listeners: new Set(),

            init() {
                try {
                    const raw = localStorage.getItem(DB_KEY);
                    if (raw) {
                        const parsed = JSON.parse(raw);
                        if (parsed && Array.isArray(parsed.contents) && Array.isArray(parsed.users) && Array.isArray(parsed.campaigns)) {
                            this.state = parsed;
                            return;
                        }
                    }
                } catch (e) {
                    console.error('Database load error, fallback to seed:', e);
                }
                this.state = createSeedDatabase();
                this.persist(false);
            },

            subscribe(fn) {
                this.listeners.add(fn);
                return () => this.listeners.delete(fn);
            },

            notify() {
                this.listeners.forEach(fn => fn(this.state));
            },

            persist(broadcast = true) {
                this.state.meta = { version: 2, updatedAt: new Date().toISOString() };
                try {
                    localStorage.setItem(DB_KEY, JSON.stringify(this.state));
                } catch (e) {
                    console.error('Storage quota exceeded:', e);
                }
                const timeEl = document.getElementById('sync-last-time');
                if (timeEl) {
                    timeEl.textContent = new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
                }
                if (broadcast) this.notify();
            },

            // ---- RELATIONAL SELECTORS ----
            getUserById(id) {
                return this.state.users.find(u => u.id === id) || null;
            },
            getCampaignById(id) {
                return this.state.campaigns.find(c => c.id === id) || { id: '', name: 'Tanpa Kampanye', client: '-', color: 'slate' };
            },
            getContentById(id) {
                return this.state.contents.find(c => c.id === id) || null;
            },
            getAssetsByContentId(contentId) {
                return this.state.assets.filter(a => a.contentId === contentId);
            },
            getCrewForContent(content) {
                return (content.planning?.crewIds || []).map(id => this.getUserById(id)).filter(Boolean);
            },

            // ---- CONFLICT ENGINE (RELASIONAL BERDASARKAN USER ID) ----
            detectScheduleConflicts() {
                const map = {};
                const conflicts = [];
                const conflictedContentIds = new Set();

                this.state.contents.forEach(item => {
                    const date = item.planning?.takeDate;
                    const crewIds = item.planning?.crewIds || [];
                    if (!date || crewIds.length === 0) return;

                    crewIds.forEach(uid => {
                        const user = this.getUserById(uid);
                        if (!user) return;
                        const key = `${date}__${uid}`;
                        if (!map[key]) map[key] = { date, user, items: [] };
                        map[key].items.push(item);
                    });
                });

                Object.values(map).forEach(entry => {
                    if (entry.items.length > 1) {
                        conflicts.push(entry);
                        entry.items.forEach(i => conflictedContentIds.add(i.id));
                    }
                });

                return { conflicts, conflictedContentIds };
            },

            // ---- CRUD: CONTENTS ----
            createContent(payload) {
                const item = { id: Utils.uid('cnt'), ...payload };
                this.state.contents.unshift(item);
                this.addNotification('info', 'Konten Baru Dibuat', `"${item.title}" ditambahkan ke ${PHASE_META[item.phase].short}.`, false);
                this.persist();
                return item;
            },
            updateContent(id, updater) {
                const item = this.getContentById(id);
                if (!item) return null;
                updater(item);
                this.persist();
                return item;
            },
            deleteContent(id) {
                this.state.contents = this.state.contents.filter(c => c.id !== id);
                this.state.assets = this.state.assets.filter(a => a.contentId !== id); // Cascade delete assets
                this.persist();
            },

            // ---- CRUD: CAMPAIGNS ----
            createCampaign(data) {
                const cmp = { id: Utils.uid('cmp'), ...data };
                this.state.campaigns.unshift(cmp);
                this.addNotification('info', 'Kampanye Baru', `Proyek "${cmp.name}" (${cmp.client}) telah dibuat.`, false);
                this.persist();
                return cmp;
            },
            deleteCampaign(id) {
                this.state.campaigns = this.state.campaigns.filter(c => c.id !== id);
                this.persist();
            },

            // ---- CRUD: USERS / CREW ----
            createUser(data) {
                const usr = { id: Utils.uid('usr'), ...data };
                this.state.users.push(usr);
                this.addNotification('info', 'Anggota Tim Ditambahkan', `${usr.name} (${usr.role}) bergabung ke workspace.`, false);
                this.persist();
                return usr;
            },
            deleteUser(id) {
                this.state.users = this.state.users.filter(u => u.id !== id);
                this.state.contents.forEach(c => {
                    if (c.planning?.crewIds) c.planning.crewIds = c.planning.crewIds.filter(uid => uid !== id);
                });
                this.persist();
            },

            // ---- CRUD: ASSETS (DAM) ----
            createAsset(data) {
                const asset = { id: Utils.uid('ast'), createdAt: new Date().toISOString().slice(0, 10), ...data };
                this.state.assets.unshift(asset);
                this.persist();
                return asset;
            },
            deleteAsset(id) {
                this.state.assets = this.state.assets.filter(a => a.id !== id);
                this.persist();
            },

            // ---- ARCHIVES & NOTIFICATIONS ----
            addArchive(entry) {
                this.state.archives.unshift({ id: Utils.uid('arc'), ...entry });
                this.persist();
            },
            addNotification(type, title, message, shouldPersist = true) {
                this.state.notifications.unshift({
                    id: Utils.uid('ntf'),
                    type,
                    title,
                    message,
                    time: new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }),
                    read: false
                });
                if (this.state.notifications.length > 30) this.state.notifications.pop();
                if (this.state.integrations?.webhookAutoTrigger && this.state.integrations?.webhookUrl) {
                    CloudAdapter.sendWebhook(title, { type, message }, this.state.integrations);
                }
                if (shouldPersist) this.persist();
            },
            markAllNotificationsRead() {
                this.state.notifications.forEach(n => n.read = true);
                this.persist();
            },
            updateIntegrations(patch) {
                this.state.integrations = { ...this.state.integrations, ...patch };
                this.persist();
            },
            replaceFullDatabase(newDb) {
                if (!newDb || !Array.isArray(newDb.contents) || !Array.isArray(newDb.users) || !Array.isArray(newDb.campaigns)) {
                    throw new Error('Format file JSON tidak valid. Pastikan berasal dari backup PRFlow Pro.');
                }
                this.state = newDb;
                this.persist();
            },
            resetToSeed() {
                this.state = createSeedDatabase();
                this.persist();
            }
        };

        /* =====================================================================
           MODULE 3: EXTERNAL INTEGRATIONS SERVICE (GCAL, .ICS, MAPS, DRIVE, EXPORT)
           ===================================================================== */
        const Integrations = {
            syncGoogleCalendar(contentId) {
                const item = Store.getContentById(contentId);
                if (!item) return;
                const cmp = Store.getCampaignById(item.campaignId);
                const crewNames = Store.getCrewForContent(item).map(u => u.name).join(', ');
                const takeDate = (item.planning.takeDate || new Date().toISOString().slice(0, 10)).replace(/-/g, '');
                const title = encodeURIComponent(`[PRFlow Take] ${item.title}`);
                const details = encodeURIComponent(`Kampanye: ${cmp.name} (${cmp.client})\nKru: ${crewNames || '-'}\nBrief: ${item.planning.brief}`);
                const location = encodeURIComponent(item.planning.location || 'Jakarta');
                const gcalUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${title}&dates=${takeDate}T090000/${takeDate}T120000&details=${details}&location=${location}`;

                Store.updateContent(contentId, c => { c.planning.gcalSynced = true; });
                window.open(gcalUrl, '_blank', 'noopener,noreferrer');
                UI.showToast('success', 'Google Calendar Terbuka', `Jadwal take "${item.title}" dikunci & siap disimpan di Google Calendar.`);
            },

            downloadICS(contentId) {
                const item = Store.getContentById(contentId);
                if (!item) return;
                const cmp = Store.getCampaignById(item.campaignId);
                const dt = (item.planning.takeDate || new Date().toISOString().slice(0, 10)).replace(/-/g, '');
                const ics = [
                    'BEGIN:VCALENDAR',
                    'VERSION:2.0',
                    'PRODID:-//PRFlow Workspace Pro//ID',
                    'BEGIN:VEVENT',
                    `UID:${item.id}@prflow.workspace`,
                    `DTSTAMP:${dt}T080000Z`,
                    `DTSTART:${dt}T090000`,
                    `DTEND:${dt}T120000`,
                    `SUMMARY:[PRFlow Take] ${item.title}`,
                    `DESCRIPTION:Kampanye: ${cmp.name} | Brief: ${(item.planning.brief || '').replace(/\n/g, ' ')}`,
                    `LOCATION:${item.planning.location || 'Kantor Pusat'}`,
                    'END:VEVENT',
                    'END:VCALENDAR'
                ].join('\r\n');

                this.triggerDownload(ics, `PRFlow_${item.id}.ics`, 'text/calendar;charset=utf-8;');
                Store.updateContent(contentId, c => { c.planning.gcalSynced = true; });
                UI.showToast('success', 'File .ICS Diunduh', 'Buka file .ics untuk impor instan ke Outlook, Apple, atau Google Calendar.');
            },

            openGoogleMaps(contentId) {
                const item = Store.getContentById(contentId);
                if (!item) return;
                const loc = encodeURIComponent(item.planning.location || 'Jakarta');
                window.open(`https://www.google.com/maps/search/?api=1&query=${loc}`, '_blank', 'noopener,noreferrer');
            },

            generateDriveFolders(contentId) {
                const item = Store.getContentById(contentId);
                if (!item) return;
                Store.updateContent(contentId, c => { c.planning.gdriveGenerated = true; });
                const existingAssets = Store.getAssetsByContentId(contentId);
                if (existingAssets.length === 0) {
                    Store.createAsset({
                        contentId,
                        folder: '01_Brief',
                        name: `Creative_Brief_${item.id}.docx`,
                        type: 'Doc',
                        url: Store.state.integrations?.gdriveRootUrl || 'https://drive.google.com',
                        version: 'v1.0',
                        uploadedBy: item.ownerId || 'usr-1'
                    });
                }
                Store.addNotification('info', 'Folder Drive & DAM Siap', `Struktur folder aset (01_Brief, 02_Raw_Footage, 03_Final_Asset) untuk "${item.title}" aktif.`);
                UI.showToast('success', 'Google Drive & DAM Tersinkronisasi', 'Struktur 3 folder aset berhasil diinisialisasi.');
            },

            exportCSV() {
                const headers = ['ID', 'Judul', 'Kampanye', 'Klien', 'PIC', 'Fase', 'PESO', 'Funnel', 'Risiko', 'Target KPI', 'KPI Aktual', 'Take Date', 'Publish Date', 'Kru', 'Live', 'Sentimen + (%)', 'Sentimen - (%)', 'Jumlah Aset'];
                const rows = Store.state.contents.map(i => {
                    const cmp = Store.getCampaignById(i.campaignId);
                    const owner = Store.getUserById(i.ownerId);
                    const crewNames = Store.getCrewForContent(i).map(u => u.name).join('; ');
                    const assetCount = Store.getAssetsByContentId(i.id).length;
                    return [
                        i.id,
                        `"${(i.title || '').replace(/"/g, '""')}"`,
                        `"${(cmp.name || '').replace(/"/g, '""')}"`,
                        `"${(cmp.client || '').replace(/"/g, '""')}"`,
                        `"${(owner?.name || '-').replace(/"/g, '""')}"`,
                        `Fase ${i.phase}`,
                        i.research.peso,
                        i.research.funnel,
                        i.research.issueRisk,
                        i.research.kpiTarget,
                        i.evaluation.kpiActual,
                        i.planning.takeDate,
                        i.planning.publishDate,
                        `"${crewNames}"`,
                        i.distribution.published ? 'Ya' : 'Belum',
                        i.distribution.sentiment.positive,
                        i.distribution.sentiment.negative,
                        assetCount
                    ];
                });
                const csv = '\uFEFF' + [headers.join(','), ...rows.map(r => r.join(','))].join('\n');
                this.triggerDownload(csv, `PRFlow_Report_${new Date().toISOString().slice(0, 10)}.csv`, 'text/csv;charset=utf-8;');
                UI.showToast('success', 'Laporan CSV Diunduh', 'Siap dibuka di Google Sheets atau Microsoft Excel.');
            },

            exportJSON() {
                const json = JSON.stringify(Store.state, null, 2);
                this.triggerDownload(json, `PRFlow_Backup_DB_${new Date().toISOString().slice(0, 10)}.json`, 'application/json;charset=utf-8;');
                UI.showToast('success', 'Backup JSON Berhasil', 'Seluruh database relasional (tim, kampanye, konten, aset, arsip) telah diunduh.');
            },

            importJSONFile(fileInput) {
                const file = fileInput.files?.[0];
                if (!file) return;
                const reader = new FileReader();
                reader.onload = (e) => {
                    try {
                        const parsed = JSON.parse(e.target.result);
                        Store.replaceFullDatabase(parsed);
                        UI.showToast('success', 'Impor Database Berhasil', 'Seluruh data workspace berhasil dipulihkan dari file JSON.');
                    } catch (err) {
                        UI.showToast('danger', 'Gagal Impor JSON', err.message || 'File rusak atau format tidak sesuai.');
                    }
                    fileInput.value = '';
                };
                reader.readAsText(file);
            },

            triggerDownload(content, filename, mime) {
                const blob = new Blob([content], { type: mime });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            }
        };

        /* =====================================================================
