                                        <div class="mt-3 p-3 rounded-xl bg-slate-50 dark:bg-slate-950/60 text-xs space-y-1.5">
                                            <div><strong class="text-slate-600 dark:text-slate-300">KPI:</strong> ${Number(item.research.kpiTarget).toLocaleString('id-ID')} ${Utils.escapeHtml(item.research.kpiMetric)}</div>
