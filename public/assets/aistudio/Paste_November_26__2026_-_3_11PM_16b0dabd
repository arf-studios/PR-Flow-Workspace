        const UI = {
            currentView: 'dashboard',
            activeDetailId: null,
            activeDrawerTab: 1,
            calendarCursor: new Date(new Date().getFullYear(), new Date().getMonth(), 1),
            plannerSubView: 'calendar',
            pendingRevisionContentId: null,
            chartInstances: {},

            init() {
                this.initTheme();
                Store.init();

                // Single Source of Truth: setiap mutasi Store langsung merefresh seluruh UI terkait!
                Store.subscribe(() => {
                    this.updateChrome();
                    this.renderCurrentView();
                    if (this.activeDetailId) {
                        if (Store.getContentById(this.activeDetailId)) {
                            this.renderDrawerContent();
                        } else {
                            this.closeDetailDrawer();
                        }
                    }
                });

                this.updateChrome();
                this.navigateTo('dashboard');
                this.bindGlobalShortcuts();
            },

            bindGlobalShortcuts() {
                document.addEventListener('keydown', (e) => {
                    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
                        e.preventDefault();
                        document.getElementById('global-search')?.focus();
                    }
                    if (e.key === 'Escape') {
                        this.closeDetailDrawer();
                        ['new-content-modal', 'entity-modal', 'revision-modal', 'confirm-modal'].forEach(id => this.closeModal(id));
                        document.getElementById('notif-panel')?.classList.add('hidden');
                    }
                });

                document.addEventListener('click', (e) => {
                    const panel = document.getElementById('notif-panel');
                    if (panel && !panel.classList.contains('hidden')) {
                        if (!e.target.closest('#notif-panel') && !e.target.closest('#notif-toggle-btn')) {
                            panel.classList.add('hidden');
                        }
                    }
                });
            },

            updateChrome() {
                // Badges
                for (let p = 1; p <= 5; p++) {
                    const el = document.getElementById(`badge-phase${p}`);
                    if (el) el.textContent = Store.state.contents.filter(i => i.phase === p).length;
                }
                const setBadge = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val; };
                setBadge('badge-campaigns', Store.state.campaigns.length);
                setBadge('badge-assets', Store.state.assets.length);
                setBadge('badge-archive', Store.state.archives.length);

                // Campaign filter select
                const select = document.getElementById('campaign-filter');
                if (select) {
                    const currentVal = select.value;
                    select.innerHTML = `<option value="ALL">Semua Kampanye (${Store.state.contents.length})</option>` +
                        Store.state.campaigns.map(c => `<option value="${Utils.escapeHtml(c.id)}" ${c.id === currentVal ? 'selected' : ''}>${Utils.escapeHtml(c.name)}</option>`).join('');
                }

                // Notifications
                const list = document.getElementById('notif-list');
                const dot = document.getElementById('notif-dot');
                const unread = Store.state.notifications.filter(n => !n.read).length;
                if (dot) dot.classList.toggle('hidden', unread === 0);
                if (list) {
                    list.innerHTML = Store.state.notifications.length === 0
                        ? `<div class="p-6 text-center text-xs text-slate-400">Belum ada notifikasi aktivitas.</div>`
                        : Store.state.notifications.map(n => `
                        <div class="p-3.5 text-xs ${n.read ? 'opacity-70' : 'bg-brand-50/50 dark:bg-brand-950/20'}">
                            <div class="flex items-center justify-between gap-2">
                                <strong class="text-slate-900 dark:text-white">${Utils.escapeHtml(n.title)}</strong>
                                <span class="text-[10px] text-slate-400 shrink-0">${Utils.escapeHtml(n.time)}</span>
                            </div>
                            <p class="text-slate-600 dark:text-slate-300 mt-0.5 leading-relaxed">${Utils.escapeHtml(n.message)}</p>
                        </div>`).join('');
                }
            },

            getFilteredContents() {
                const q = (document.getElementById('global-search')?.value || '').toLowerCase().trim();
                const campId = document.getElementById('campaign-filter')?.value || 'ALL';

                return Store.state.contents.filter(item => {
                    if (campId !== 'ALL' && item.campaignId !== campId) return false;
                    if (!q) return true;
                    const cmp = Store.getCampaignById(item.campaignId);
                    const crew = Store.getCrewForContent(item).map(u => u.name);
                    const hay = [
                        item.title, cmp.name, cmp.client, item.research.pillar,
                        item.research.peso, item.research.issueAudit, item.planning.location, ...crew
                    ].join(' ').toLowerCase();
                    return hay.includes(q);
                });
            },

            navigateTo(view) {
