            collectAndSaveCurrentDrawerTab(showFeedback = true) {
                const item = Store.getContentById(this.activeDetailId);
                if (!item || this.activeDrawerTab === 6) return;

                Store.updateContent(item.id, c => {
                    if (this.activeDrawerTab === 1 && document.getElementById('ed-title')) {
                        c.title = document.getElementById('ed-title').value.trim() || c.title;
                        c.campaignId = document.getElementById('ed-campaign-id').value;
                        c.ownerId = document.getElementById('ed-owner-id').value;
                        c.research.peso = document.getElementById('ed-peso').value;
                        c.research.funnel = document.getElementById('ed-funnel').value;
                        c.research.issueRisk = document.getElementById('ed-risk').value;
                        c.research.kpiMetric = document.getElementById('ed-kpimetric').value;
                        c.research.kpiTarget = Number(document.getElementById('ed-kpitarget').value) || 0;
                        c.research.pillar = document.getElementById('ed-pillar').value;
                        c.research.format = document.getElementById('ed-format').value;
                        c.research.audience = document.getElementById('ed-audience').value;
                        c.research.issueAudit = document.getElementById('ed-issue').value;
                    } else if (this.activeDrawerTab === 2 && document.getElementById('ed-brief')) {
                        c.planning.brief = document.getElementById('ed-brief').value;
                        c.planning.outline = document.getElementById('ed-outline').value;
                        c.planning.needsBriefRevision = document.getElementById('ed-revbrief').checked;
                        c.planning.briefRevisionNote = document.getElementById('ed-revbriefnote').value;
                        c.planning.takeDate = document.getElementById('ed-takedate').value;
                        c.planning.publishDate = document.getElementById('ed-pubdate').value;
                        c.planning.publishTime = document.getElementById('ed-pubtime').value;
                        c.planning.crewIds = [...document.querySelectorAll('input[name="ed-crew-ids"]:checked')].map(el => el.value);
                        c.planning.location = document.getElementById('ed-location').value;
                        c.planning.travelEstimate = document.getElementById('ed-travel').value;
                    } else if (this.activeDrawerTab === 3 && document.getElementById('ed-stage')) {
                        c.production.stage = document.getElementById('ed-stage').value;
                        c.production.preProdChecklist = {
                            kamera: document.getElementById('chk-kamera').checked,
                            audio: document.getElementById('chk-audio').checked,
                            lighting: document.getElementById('chk-lighting').checked,
                            briefingMeet: document.getElementById('chk-meet').checked
                        };
                        c.production.qcChecklist = {
                            visualAudio: document.getElementById('qc-visual').checked,
                            tonePR: document.getElementById('qc-tone').checked,
                            brandSafety: document.getElementById('qc-safety').checked,
                            akurasiData: document.getElementById('qc-data').checked
                        };
                    } else if (this.activeDrawerTab === 4 && document.getElementById('ed-published')) {
                        c.distribution.channels = [...document.querySelectorAll('input[name="ed-channels"]:checked')].map(el => el.value);
                        c.distribution.published = document.getElementById('ed-published').checked;
                        c.distribution.sentiment = {
                            positive: Number(document.getElementById('ed-sent-pos').value) || 0,
                            neutral: Number(document.getElementById('ed-sent-neu').value) || 0,
                            negative: Number(document.getElementById('ed-sent-neg').value) || 0
                        };
                        c.distribution.mentions = Number(document.getElementById('ed-mentions').value) || 0;
                        c.distribution.responseStatus = document.getElementById('ed-respstatus').value;
                    } else if (this.activeDrawerTab === 5 && document.getElementById('ed-kpiactual')) {
                        c.evaluation.kpiActual = Number(document.getElementById('ed-kpiactual').value) || 0;
                        c.evaluation.auditCause = document.getElementById('ed-auditcause').value;
                        c.evaluation.actionTaken = document.getElementById('ed-actiontaken').value;
                        c.evaluation.auditNotes = document.getElementById('ed-auditnotes').value;
                    }
                });

                if (showFeedback) {
                    this.showToast('success', 'Perubahan Disimpan', 'Seluruh modul (kalender, dashboard, grafik) telah diperbarui.');
                }
            },

            advancePhase(id, targetPhase, stayInDrawer = false) {
                const item = Store.getContentById(id);
                if (!item) return;
                if (stayInDrawer) this.collectAndSaveCurrentDrawerTab(false);
                Store.updateContent(id, c => { c.phase = targetPhase; });
                if (stayInDrawer) {
                    this.activeDrawerTab = targetPhase;
                    this.renderDrawerContent();
                }
                this.showToast('success', `Berpindah ke Fase ${targetPhase}`, `"${item.title}" masuk ke ${PHASE_META[targetPhase].name}.`);
            },

            /* =====================================================================
               MODULE 6: MODALS (CREATE CONTENT, CAMPAIGN, USER, ASSET, CONFIRM)
               ===================================================================== */
            openModal(id) {
                const el = document.getElementById(id);
                if (!el) return;
                el.classList.remove('hidden');
                el.classList.add('flex');
                lucide.createIcons();
            },

            closeModal(id) {
                const el = document.getElementById(id);
                if (!el) return;
                el.classList.add('hidden');
                el.classList.remove('flex');
            },

            openNewContentModal(defaultPhase = 1) {
                document.getElementById('new-content-form').reset();
                document.getElementById('nc-phase').value = String(defaultPhase);
                document.getElementById('nc-campaign-id').innerHTML = Store.state.campaigns.map(c => `<option value="${c.id}">${Utils.escapeHtml(c.name)} (${Utils.escapeHtml(c.client)})</option>`).join('');
                document.getElementById('nc-owner-id').innerHTML = Store.state.users.map(u => `<option value="${u.id}">${Utils.escapeHtml(u.name)} — ${Utils.escapeHtml(u.role)}</option>`).join('');
                this.openModal('new-content-modal');
            },

