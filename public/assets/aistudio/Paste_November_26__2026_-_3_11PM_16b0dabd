                            <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-cyan-600 dark:text-cyan-400 mb-1">
                                <i data-lucide="calendar-days" class="w-4 h-4"></i> Fase 2 Alur Kerja PR
                            </div>
                            <h2 class="font-display text-2xl font-extrabold tracking-tight">Perencanaan, Kalender & Workspace Sync</h2>
                            <p class="text-sm text-slate-500 dark:text-slate-400">Detektor bentrok kru relasional, ekspor Google Calendar/.ICS, lokasi Maps tertanam, dan folder aset Drive.</p>
                        </div>
                        <div class="flex items-center gap-1 bg-slate-200/80 dark:bg-slate-800 p-1 rounded-xl self-start">
                            <button onclick="UI.setPlannerSubView('calendar')" class="px-3 py-1.5 text-xs font-semibold rounded-lg transition-all ${this.plannerSubView === 'calendar' ? 'bg-white dark:bg-slate-900 shadow-sm text-slate-900 dark:text-white' : 'text-slate-500'}">Kalender Bulanan</button>
                            <button onclick="UI.setPlannerSubView('list')" class="px-3 py-1.5 text-xs font-semibold rounded-lg transition-all ${this.plannerSubView === 'list' ? 'bg-white dark:bg-slate-900 shadow-sm text-slate-900 dark:text-white' : 'text-slate-500'}">Daftar & Integrasi</button>
                        </div>
                    </div>

                    ${conflicts.length > 0 ? `
                    <div class="p-4 rounded-2xl bg-amber-50 dark:bg-amber-950/40 border-2 border-amber-300 dark:border-amber-700/80 space-y-2.5 shadow-soft">
                        <div class="flex items-center gap-2 text-amber-800 dark:text-amber-300 font-bold text-sm">
                            <i data-lucide="alert-octagon" class="w-5 h-5"></i>
                            Detektor Bentrok Relasional: ${conflicts.length} Jadwal Kru Bertabrakan
                        </div>
                        <div class="space-y-2">
                            ${conflicts.map(c => `
                            <div class="p-3 rounded-xl bg-white/90 dark:bg-slate-900/90 border border-amber-200 dark:border-amber-800 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs">
                                <div>
                                    <span class="font-bold text-amber-700 dark:text-amber-400">${Utils.escapeHtml(c.user.name)}</span> (${Utils.escapeHtml(c.user.role)}) bentrok pada <strong>${Utils.formatDateID(c.date)}</strong>:
                                    ${c.items.map(i => `<button onclick="UI.openDetailDrawer('${i.id}', 2)" class="underline font-semibold text-brand-600 dark:text-brand-400 mx-1">${Utils.escapeHtml(i.title)}</button>`).join('&')}
                                </div>
                                <span class="px-2.5 py-1 rounded-lg bg-amber-100 dark:bg-amber-900/60 text-amber-800 dark:text-amber-200 font-semibold shrink-0">Ubah Tanggal / Kru</span>
                            </div>`).join('')}
                        </div>
                    </div>` : `
                    <div class="p-3.5 rounded-2xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800/60 flex items-center gap-3 text-xs text-emerald-800 dark:text-emerald-300 font-medium">
                        <i data-lucide="check-circle-2" class="w-4 h-4 shrink-0"></i>
                        Seluruh jadwal kru & talent bebas bentrok pada tanggal take yang direncanakan.
                    </div>`}

                    ${this.plannerSubView === 'calendar' ? this.buildCalendarHTML(items, conflictedContentIds) : this.buildPlannerCardsHTML(items, conflictedContentIds)}
                `;
            },

            setPlannerSubView(mode) {
                this.plannerSubView = mode;
                this.renderCurrentView();
            },

            shiftCalendarMonth(delta) {
                if (delta === 0) {
                    const now = new Date();
                    this.calendarCursor = new Date(now.getFullYear(), now.getMonth(), 1);
                } else {
                    this.calendarCursor = new Date(this.calendarCursor.getFullYear(), this.calendarCursor.getMonth() + delta, 1);
                }
                this.renderCurrentView();
            },

            buildCalendarHTML(items, conflictedContentIds) {
                const year = this.calendarCursor.getFullYear();
                const month = this.calendarCursor.getMonth();
                const monthName = this.calendarCursor.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' });
                const firstDay = new Date(year, month, 1).getDay();
                const daysInMonth = new Date(year, month + 1, 0).getDate();
                const todayStr = new Date().toISOString().slice(0, 10);
                const dayNames = ['Min', 'Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab'];

                let cells = '';
                for (let i = 0; i < firstDay; i++) {
                    cells += `<div class="min-h-[104px] p-2 bg-slate-50/60 dark:bg-slate-950/40 border-r border-b border-slate-200/80 dark:border-slate-800"></div>`;
                }
                for (let d = 1; d <= daysInMonth; d++) {
                    const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
                    const isToday = dateStr === todayStr;
                    const takeEvents = items.filter(i => i.planning.takeDate === dateStr);
                    const pubEvents = items.filter(i => i.planning.publishDate === dateStr);

                    cells += `
                    <div class="min-h-[108px] p-2 bg-white dark:bg-slate-900 border-r border-b border-slate-200/80 dark:border-slate-800 flex flex-col gap-1">
                        <div class="flex items-center justify-between mb-0.5">
                            <span class="text-xs font-bold ${isToday ? 'w-6 h-6 rounded-full bg-brand-600 text-white flex items-center justify-center' : 'text-slate-500 dark:text-slate-400'}">${d}</span>
                        </div>
                        ${takeEvents.map(ev => {
                            const clash = conflictedContentIds.has(ev.id);
                            return `
                            <button onclick="UI.openDetailDrawer('${ev.id}', 2)" class="w-full text-left px-2 py-1 rounded-lg text-[11px] font-semibold truncate transition-all ${clash ? 'bg-amber-100 text-amber-900 border border-amber-400 dark:bg-amber-900/70 dark:text-amber-100' : 'bg-cyan-50 text-cyan-800 border border-cyan-200 dark:bg-cyan-950/60 dark:text-cyan-200 dark:border-cyan-800'}">
                                🎬 ${Utils.escapeHtml(ev.title)}
                            </button>`;
                        }).join('')}
                        ${pubEvents.map(ev => `
                            <button onclick="UI.openDetailDrawer('${ev.id}', 2)" class="w-full text-left px-2 py-1 rounded-lg text-[11px] font-semibold truncate bg-brand-50 text-brand-800 border border-brand-200 dark:bg-brand-950/60 dark:text-brand-200 dark:border-brand-800">
                                🚀 ${Utils.escapeHtml(ev.title)}
                            </button>
                        `).join('')}
                    </div>`;
                }

                return `
                <div class="rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 overflow-hidden shadow-soft">
                    <div class="px-5 py-4 border-b border-slate-200/80 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3">
                        <div class="flex items-center gap-3">
                            <h3 class="font-display font-bold text-base capitalize">${monthName}</h3>
                            <div class="flex items-center gap-1">
                                <button onclick="UI.shiftCalendarMonth(-1)" class="p-1.5 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800"><i data-lucide="chevron-left" class="w-4 h-4"></i></button>
                                <button onclick="UI.shiftCalendarMonth(0)" class="px-2.5 py-1 text-xs font-semibold rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800">Bulan Ini</button>
                                <button onclick="UI.shiftCalendarMonth(1)" class="p-1.5 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800"><i data-lucide="chevron-right" class="w-4 h-4"></i></button>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 text-xs">
                            <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-cyan-500"></span> Take</span>
                            <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-amber-500"></span> Bentrok</span>
                            <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-brand-500"></span> Tayang</span>
                        </div>
                    </div>
                    <div class="overflow-x-auto">
                        <div class="min-w-[720px]">
                            <div class="grid grid-cols-7 bg-slate-50 dark:bg-slate-950/60 border-b border-slate-200 dark:border-slate-800 text-center text-xs font-bold text-slate-500 py-2.5">
                                ${dayNames.map(dn => `<div>${dn}</div>`).join('')}
                            </div>
                            <div class="grid grid-cols-7">${cells}</div>
                        </div>
                    </div>
                </div>
                <div class="pt-2 space-y-3">
                    <h3 class="font-display font-bold text-sm">Integrasi Google Workspace, Kalender .ICS & Status Brief</h3>
                    ${this.buildPlannerCardsHTML(items, conflictedContentIds)}
                </div>`;
            },

            buildPlannerCardsHTML(items, conflictedContentIds) {
                if (items.length === 0) {
                    return `<div class="p-10 rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 text-center text-sm text-slate-500">Belum ada jadwal konten.</div>`;
                }
                return `
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                    ${items.map(item => {
                        const clash = conflictedContentIds.has(item.id);
                        const p = item.planning;
                        const crew = Store.getCrewForContent(item);
                        const assets = Store.getAssetsByContentId(item.id);
                        return `
                        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border ${clash ? 'border-amber-400 dark:border-amber-600' : 'border-slate-200/80 dark:border-slate-800'} shadow-soft space-y-4">
                            <div class="flex items-start justify-between gap-2">
                                <div>
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <span class="text-[11px] font-bold px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800">${PHASE_META[item.phase].short}</span>
                                        ${p.needsBriefRevision ? `<span class="text-[11px] font-bold px-2 py-0.5 rounded bg-rose-100 text-rose-700 dark:bg-rose-950 dark:text-rose-300">Revisi Konsep!</span>` : `<span class="text-[11px] font-semibold px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300">Brief Siap</span>`}
                                        ${clash ? `<span class="text-[11px] font-bold px-2 py-0.5 rounded bg-amber-100 text-amber-800">Kru Bentrok</span>` : ''}
                                    </div>
                                    <h4 class="font-display font-bold text-base mt-1.5 cursor-pointer hover:text-brand-600" onclick="UI.openDetailDrawer('${item.id}', 2)">${Utils.escapeHtml(item.title)}</h4>
                                </div>
                                <button onclick="UI.openDetailDrawer('${item.id}', 2)" class="p-2 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700" title="Edit Jadwal & Peta">
                                    <i data-lucide="sliders-horizontal" class="w-4 h-4"></i>
                                </button>
                            </div>

                            ${p.needsBriefRevision ? `
                            <div class="p-3 rounded-xl bg-rose-50 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-800/60 text-xs text-rose-800 dark:text-rose-200">
                                <strong>Revisi Brief:</strong> ${Utils.escapeHtml(p.briefRevisionNote || 'Perlu penyesuaian outline & script.')}
                            </div>` : ''}

                            <div class="grid grid-cols-2 gap-3 text-xs bg-slate-50 dark:bg-slate-950/60 p-3 rounded-xl">
                                <div>
                                    <span class="text-slate-400 block">Take & Tim Kru (${crew.length})</span>
                                    <strong class="text-slate-800 dark:text-slate-200">${Utils.formatDateID(p.takeDate)}</strong>
                                    <div class="text-slate-500 mt-0.5 truncate">${Utils.escapeHtml(crew.map(u => u.name).join(', ') || 'Belum ada kru')}</div>
                                </div>
                                <div>
                                    <span class="text-slate-400 block">Tayang Prime Time</span>
                                    <strong class="text-slate-800 dark:text-slate-200">${Utils.formatDateID(p.publishDate)} (${Utils.escapeHtml(p.publishTime || '19:00')})</strong>
                                    <div class="text-slate-500 mt-0.5 truncate">${Utils.escapeHtml(p.location || 'Lokasi belum diisi')}</div>
                                </div>
                            </div>

                            <!-- Aksi Integrasi Eksternal -->
                            <div class="flex flex-wrap gap-2">
                                <button onclick="Integrations.syncGoogleCalendar('${item.id}')" class="px-2.5 py-1.5 rounded-xl text-xs font-semibold border transition-all flex items-center gap-1.5 ${p.gcalSynced ? 'bg-emerald-50 border-emerald-200 text-emerald-700 dark:bg-emerald-950/40 dark:border-emerald-800 dark:text-emerald-300' : 'bg-white dark:bg-slate-800 border-slate-200 dark:border-slate-700 hover:border-brand-500'}">
                                    <i data-lucide="calendar-check" class="w-3.5 h-3.5"></i> ${p.gcalSynced ? 'GCal Synced ✓' : 'Google Calendar'}
                                </button>
                                <button onclick="Integrations.downloadICS('${item.id}')" class="px-2.5 py-1.5 rounded-xl text-xs font-semibold border bg-white dark:bg-slate-800 border-slate-200 dark:border-slate-700 hover:border-brand-500 flex items-center gap-1.5">
                                    <i data-lucide="calendar-plus" class="w-3.5 h-3.5 text-brand-500"></i> .ICS
                                </button>
                                <button onclick="Integrations.openGoogleMaps('${item.id}')" class="px-2.5 py-1.5 rounded-xl text-xs font-semibold border bg-white dark:bg-slate-800 border-slate-200 dark:border-slate-700 hover:border-cyan-500 flex items-center gap-1.5">
                                    <i data-lucide="map-pin" class="w-3.5 h-3.5 text-rose-500"></i> Maps
                                </button>
                                <button onclick="Integrations.generateDriveFolders('${item.id}')" class="px-2.5 py-1.5 rounded-xl text-xs font-semibold border transition-all flex items-center gap-1.5 ${p.gdriveGenerated ? 'bg-blue-50 border-blue-200 text-blue-700 dark:bg-blue-950/40 dark:border-blue-800 dark:text-blue-300' : 'bg-white dark:bg-slate-800 border-slate-200 dark:border-slate-700 hover:border-blue-500'}">
                                    <i data-lucide="folder-plus" class="w-3.5 h-3.5"></i> Drive (${assets.length} file)
                                </button>
                            </div>

                            ${item.phase === 2 ? `
                            <div class="pt-2 border-t border-slate-100 dark:border-slate-800 flex justify-end">
                                <button onclick="UI.advancePhase('${item.id}', 3)" ${clash || p.needsBriefRevision ? 'disabled' : ''} class="px-4 py-2 rounded-xl text-xs font-semibold flex items-center gap-1.5 ${clash || p.needsBriefRevision ? 'bg-slate-200 text-slate-400 dark:bg-slate-800 cursor-not-allowed' : 'bg-brand-600 hover:bg-brand-700 text-white'}">
                                    ${clash ? 'Selesaikan Bentrok Dulu' : (p.needsBriefRevision ? 'Selesaikan Revisi Brief' : 'Kirim ke Fase 3: Produksi →')}
                                </button>
                            </div>` : ''}
                        </div>`;
                    }).join('')}
                </div>`;
            },

            /* -------------------- VIEW 4: FASE 3 KANBAN PRODUKSI & QC -------------------- */
            renderPhase3(container) {
                const phase3Items = this.getFilteredContents().filter(i => i.phase === 3);

                container.innerHTML = `
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div>
                            <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400 mb-1">
                                <i data-lucide="clapperboard" class="w-4 h-4"></i> Fase 3 Alur Kerja PR
                            </div>
                            <h2 class="font-display text-2xl font-extrabold tracking-tight">Kanban Produksi, QC Teknis & Brand Safety</h2>
                            <p class="text-sm text-slate-500 dark:text-slate-400">Drag & drop kartu antar tahap, validasi checklist QC PR Brand Safety, serta jalankan loop Approval & Revisi.</p>
                        </div>
                        <button onclick="UI.openNewContentModal(3)" class="px-4 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white text-xs font-semibold flex items-center gap-2 self-start shadow-sm">
                            <i data-lucide="plus" class="w-4 h-4"></i> Tambah ke Produksi
                        </button>
                    </div>

                    <div class="flex gap-4 overflow-x-auto pb-4 items-start">
                        ${KANBAN_STAGES.map(stage => {
                            const colItems = phase3Items.filter(i => i.production.stage === stage.id);
                            return `
                            <div class="w-80 shrink-0 rounded-2xl bg-slate-100/90 dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 p-3 flex flex-col gap-3 kanban-col transition-colors"
                                 ondragover="event.preventDefault(); this.classList.add('drag-over')"
                                 ondragleave="this.classList.remove('drag-over')"
                                 ondrop="UI.handleKanbanDrop(event, '${stage.id}', this)">
                                <div class="flex items-center justify-between px-1">
                                    <span class="text-xs font-bold px-2.5 py-1 rounded-lg ${stage.badge}">${stage.label}</span>
                                    <span class="text-xs font-bold text-slate-500">${colItems.length}</span>
                                </div>
                                <div class="space-y-3 flex-1">
                                    ${colItems.length === 0 ? `
                                    <div class="p-6 rounded-xl border border-dashed border-slate-300 dark:border-slate-700 text-center text-xs text-slate-400">
                                        Kosong — seret kartu ke sini
                                    </div>` : colItems.map(item => this.buildKanbanCardHTML(item, stage.id)).join('')}
                                </div>
                            </div>`;
                        }).join('')}
                    </div>
                `;
            },

            buildKanbanCardHTML(item, stageId) {
                const cmp = Store.getCampaignById(item.campaignId);
                const prod = item.production;
                const preDone = Object.values(prod.preProdChecklist).filter(Boolean).length;
                const qcDone = Object.values(prod.qcChecklist).filter(Boolean).length;
                const assetCount = Store.getAssetsByContentId(item.id).length;

                return `
                <div draggable="true" ondragstart="event.dataTransfer.setData('text/plain', '${item.id}')" class="p-4 rounded-xl bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 shadow-soft hover:border-brand-500 transition-all space-y-3 cursor-grab active:cursor-grabbing">
                    <div class="flex items-start justify-between gap-2">
                        <span class="px-2 py-0.5 text-[10px] font-bold rounded border ${Utils.pesoBadgeClass(item.research.peso)}">${Utils.escapeHtml(item.research.peso)}</span>
                        <span class="text-[11px] text-slate-400 flex items-center gap-1"><i data-lucide="paperclip" class="w-3 h-3"></i> ${assetCount} aset</span>
                    </div>

                    <h4 class="font-bold text-sm text-slate-900 dark:text-white leading-snug cursor-pointer hover:text-brand-600" onclick="UI.openDetailDrawer('${item.id}', 3)">${Utils.escapeHtml(item.title)}</h4>
                    <div class="text-[11px] text-slate-500">${Utils.escapeHtml(cmp.name)}</div>

                    <div class="grid grid-cols-2 gap-2 text-[11px]">
                        <div class="p-2 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-100 dark:border-slate-800">
                            <span class="text-slate-400 block">Pra-Prod</span>
                            <strong class="${preDone === 4 ? 'text-emerald-600' : 'text-slate-700 dark:text-slate-300'}">${preDone}/4 Siap</strong>
                        </div>
                        <div class="p-2 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-100 dark:border-slate-800">
                            <span class="text-slate-400 block">QC Safety</span>
                            <strong class="${qcDone === 4 ? 'text-emerald-600' : 'text-amber-600'}">${qcDone}/4 Lolos</strong>
                        </div>
                    </div>

                    ${prod.revisions.length > 0 ? `
                    <div class="p-2.5 rounded-lg bg-rose-50 dark:bg-rose-950/40 border border-rose-200/70 dark:border-rose-800/60 text-[11px] text-rose-700 dark:text-rose-300">
                        <strong>Revisi #${prod.revisions.length}:</strong> ${Utils.escapeHtml(prod.revisions[0].note)}
                    </div>` : ''}

                    <div class="pt-2 border-t border-slate-100 dark:border-slate-800 flex flex-wrap gap-1.5">
                        ${stageId === 'qc_safety' || stageId === 'approval' ? `
                            <button onclick="UI.approveKanbanItem('${item.id}')" class="flex-1 px-2.5 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-[11px] font-semibold">
                                ${stageId === 'qc_safety' ? 'Lolos QC ✓' : 'Setujui Final ✓'}
                            </button>
                            <button onclick="UI.openRevisionModal('${item.id}')" class="px-2.5 py-1.5 rounded-lg bg-rose-100 hover:bg-rose-200 text-rose-700 dark:bg-rose-950 dark:text-rose-300 text-[11px] font-semibold">
                                Revisi
                            </button>
                        ` : stageId === 'siap_tayang' ? `
                            <button onclick="UI.advancePhase('${item.id}', 4)" class="w-full px-3 py-1.5 rounded-lg bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold flex items-center justify-center gap-1.5">
                                Lanjut Fase 4: Distribusi <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                            </button>
                        ` : `
                            <button onclick="UI.moveKanbanNext('${item.id}')" class="w-full px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-brand-600 hover:text-white text-xs font-semibold transition-colors">
                                Tahap Berikutnya &rarr;
                            </button>
                        `}
                    </div>
                </div>`;
            },

            handleKanbanDrop(e, targetStageId, colEl) {
                e.preventDefault();
                colEl.classList.remove('drag-over');
                const id = e.dataTransfer.getData('text/plain');
                const item = Store.getContentById(id);
                if (!item) return;
                Store.updateContent(id, c => { c.phase = 3; c.production.stage = targetStageId; });
                this.showToast('info', 'Status Kanban Diperbarui', `"${item.title}" dipindahkan ke ${KANBAN_STAGES.find(s => s.id === targetStageId).label}.`);
            },

            moveKanbanNext(id) {
                const item = Store.getContentById(id);
                if (!item) return;
                const idx = KANBAN_STAGES.findIndex(s => s.id === item.production.stage);
                if (idx >= 0 && idx < KANBAN_STAGES.length - 1) {
                    Store.updateContent(id, c => { c.production.stage = KANBAN_STAGES[idx + 1].id; });
                    this.showToast('success', 'Progres Produksi', `Masuk ke tahap ${KANBAN_STAGES[idx + 1].label}.`);
                }
            },

            approveKanbanItem(id) {
                const item = Store.getContentById(id);
                if (!item) return;
                if (item.production.stage === 'qc_safety') {
                    Store.updateContent(id, c => {
                        c.production.qcChecklist = { visualAudio: true, tonePR: true, brandSafety: true, akurasiData: true };
                        c.production.stage = 'approval';
                    });
                    Store.addNotification('info', 'Lolos QC Brand Safety', `"${item.title}" masuk Final Approval Klien.`);
                    this.showToast('success', 'Lolos QC Brand Safety', 'Diteruskan ke Final Approval Klien.');
                } else {
                    Store.updateContent(id, c => { c.production.stage = 'siap_tayang'; });
                    Store.addNotification('success', 'Final Approval Disetujui', `"${item.title}" siap tayang ke Fase 4 Distribusi.`);
                    this.showToast('success', 'Disetujui (Aset Final)', 'Siap meluncur ke Fase 4 Distribusi.');
                }
            },

            openRevisionModal(contentId) {
                this.pendingRevisionContentId = contentId;
                document.getElementById('revision-note-input').value = '';
                this.openModal('revision-modal');
            },

            submitRevisionNote() {
                const note = document.getElementById('revision-note-input').value.trim();
                if (!note) return this.showToast('warning', 'Catatan Kosong', 'Harap tuliskan detail revisi terlebih dahulu.');
                const item = Store.getContentById(this.pendingRevisionContentId);
                if (!item) return;

                const nowStr = new Date().toLocaleString('id-ID', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
                Store.updateContent(item.id, c => {
                    c.production.revisions.unshift({ date: nowStr, by: 'PR Manager / Klien', note });
                    c.production.stage = 'editing';
                });
                Store.addNotification('warning', 'Revisi Diminta', `"${item.title}" dikembalikan ke Editing. Catatan: ${note}`);
                this.closeModal('revision-modal');
                this.showToast('warning', 'Revisi Dikirim', 'Kartu dikembalikan ke kolom Editing & Copywriting.');
            },

            /* -------------------- VIEW 5: FASE 4 DISTRIBUSI & MONITORING -------------------- */
            renderPhase4(container) {
                const items = this.getFilteredContents().filter(i => i.phase === 4 || (i.phase === 3 && i.production.stage === 'siap_tayang') || i.distribution.published);

                container.innerHTML = `
                    <div>
                        <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-sky-600 dark:text-sky-400 mb-1">
                            <i data-lucide="radio" class="w-4 h-4"></i> Fase 4 Alur Kerja PR
                        </div>
                        <h2 class="font-display text-2xl font-extrabold tracking-tight">Distribusi Multi-Kanal & Monitoring Sentimen</h2>
                        <p class="text-sm text-slate-500 dark:text-slate-400">Publikasi Prime Time sesuai strategi PESO, pemantauan sentimen real-time, dan respon audiens.</p>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
                        ${items.length === 0 ? `
                        <div class="lg:col-span-2 p-12 rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 text-center space-y-2">
                            <div class="text-slate-500 text-sm font-semibold">Belum ada konten siap publikasi di Fase 4.</div>
                            <p class="text-xs text-slate-400">Selesaikan tahap Final Approval di Fase 3 untuk memasukkan konten ke antrean tayang.</p>
                        </div>` : items.map(item => {
                            const d = item.distribution;
                            const s = d.sentiment;
                            return `
                            <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-soft space-y-4">
                                <div class="flex items-start justify-between gap-3">
                                    <div>
                                        <div class="flex items-center gap-2 mb-1">
                                            <span class="px-2 py-0.5 text-[11px] font-bold rounded border ${Utils.pesoBadgeClass(item.research.peso)}">${Utils.escapeHtml(item.research.peso)}</span>
                                            ${d.published
                                                ? `<span class="px-2 py-0.5 text-[11px] font-bold rounded-full bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300 flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Live</span>`
                                                : `<span class="px-2 py-0.5 text-[11px] font-bold rounded-full bg-amber-100 text-amber-700 dark:bg-amber-950 dark:text-amber-300">Antrean Prime Time</span>`
                                            }
                                        </div>
                                        <h4 class="font-display font-bold text-base cursor-pointer hover:text-brand-600" onclick="UI.openDetailDrawer('${item.id}', 4)">${Utils.escapeHtml(item.title)}</h4>
                                        <p class="text-xs text-slate-500 mt-0.5">Prime Time: <strong>${Utils.formatDateID(item.planning.publishDate)} • ${Utils.escapeHtml(item.planning.publishTime || '19:00')} WIB</strong></p>
                                    </div>
                                    <button onclick="UI.openDetailDrawer('${item.id}', 4)" class="p-2 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700"><i data-lucide="edit-3" class="w-4 h-4"></i></button>
                                </div>

                                <div class="flex flex-wrap gap-1.5">
                                    ${(d.channels || []).map(ch => `<span class="px-2.5 py-1 text-xs font-medium rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200">${Utils.escapeHtml(ch)}</span>`).join('')}
                                </div>

                                <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200/70 dark:border-slate-800 space-y-3">
                                    <div class="flex items-center justify-between text-xs">
                                        <span class="font-bold text-slate-700 dark:text-slate-200">Sentimen Publik</span>
                                        <span class="text-slate-500"><strong>${Number(d.mentions || 0).toLocaleString('id-ID')}</strong> Mention</span>
                                    </div>
                                    <div class="w-full h-3 rounded-full overflow-hidden flex bg-slate-200 dark:bg-slate-800">
                                        <div class="bg-emerald-500 h-full transition-all" style="width: ${s.positive}%"></div>
                                        <div class="bg-slate-400 h-full transition-all" style="width: ${s.neutral}%"></div>
                                        <div class="bg-rose-500 h-full transition-all" style="width: ${s.negative}%"></div>
                                    </div>
                                    <div class="flex items-center justify-between text-[11px] font-semibold">
                                        <span class="text-emerald-600 dark:text-emerald-400">Positif: ${s.positive}%</span>
                                        <span class="text-slate-500">Netral: ${s.neutral}%</span>
                                        <span class="text-rose-600 dark:text-rose-400">Negatif: ${s.negative}%</span>
                                    </div>
                                    <div class="flex items-center justify-between pt-2 border-t border-slate-200/70 dark:border-slate-800 text-xs">
                                        <span class="text-slate-500">Respon Komunitas:</span>
