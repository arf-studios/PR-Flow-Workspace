        function shiftCalendarMonth(delta) {
            calendarCursor = new Date(calendarCursor.getFullYear(), calendarCursor.getMonth() + delta, 1);
            renderCurrentView();
        }

        function renderInteractiveCalendar(items, conflictedItemIds) {
            const year = calendarCursor.getFullYear();
            const month = calendarCursor.getMonth();
            const monthName = calendarCursor.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' });
            const firstDay = new Date(year, month, 1).getDay(); // 0=Min
            const daysInMonth = new Date(year, month + 1, 0).getDate();

            const dayNames = ['Min', 'Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab'];
            let cells = '';

            for (let i = 0; i < firstDay; i++) {
                cells += `<div class="min-h-[100px] p-2 bg-slate-50/50 dark:bg-slate-950/30 border-r border-b border-slate-200 dark:border-slate-800"></div>`;
            }

            for (let d = 1; d <= daysInMonth; d++) {
                const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
                const takeEvents = items.filter(i => i.planning.takeDate === dateStr);
                const pubEvents = items.filter(i => i.planning.publishDate === dateStr);

                cells += `
                <div class="min-h-[110px] p-2 bg-white dark:bg-slate-900 border-r border-b border-slate-200 dark:border-slate-800 flex flex-col gap-1">
                    <div class="text-xs font-bold text-slate-500 dark:text-slate-400 mb-1">${d}</div>
                    ${takeEvents.map(ev => {
                        const clash = conflictedItemIds.has(ev.id);
                        return `
                        <button onclick="openDetailDrawer('${ev.id}', 2)" class="w-full text-left px-2 py-1 rounded-lg text-[11px] font-semibold truncate transition-all ${clash ? 'bg-amber-100 text-amber-900 border border-amber-400 dark:bg-amber-900/70 dark:text-amber-100' : 'bg-cyan-50 text-cyan-800 border border-cyan-200 dark:bg-cyan-950/60 dark:text-cyan-200 dark:border-cyan-800'}">
                            🎬 Take: ${escapeHtml(ev.title)}
                        </button>`;
                    }).join('')}
                    ${pubEvents.map(ev => `
                        <button onclick="openDetailDrawer('${ev.id}', 2)" class="w-full text-left px-2 py-1 rounded-lg text-[11px] font-semibold truncate bg-brand-50 text-brand-800 border border-brand-200 dark:bg-brand-950/60 dark:text-brand-200 dark:border-brand-800">
                            🚀 Tayang: ${escapeHtml(ev.title)}
                        </button>
                    `).join('')}
                </div>`;
            }

            return `
            <div class="rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 overflow-hidden shadow-xs">
                <div class="px-5 py-4 border-b border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3">
                    <div class="flex items-center gap-3">
                        <h3 class="font-bold text-base capitalize">${monthName}</h3>
                        <div class="flex items-center gap-1">
                            <button onclick="shiftCalendarMonth(-1)" class="p-1.5 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800"><i data-lucide="chevron-left" class="w-4 h-4"></i></button>
                            <button onclick="shiftCalendarMonth(1)" class="p-1.5 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800"><i data-lucide="chevron-right" class="w-4 h-4"></i></button>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 text-xs">
                        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-cyan-500"></span> Jadwal Take</span>
                        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-amber-500"></span> Take Bentrok</span>
                        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-sm bg-brand-500"></span> Prime Time Tayang</span>
                    </div>
                </div>
                <div class="overflow-x-auto">
                    <div class="min-w-[700px]">
                        <div class="grid grid-cols-7 bg-slate-50 dark:bg-slate-950/60 border-b border-slate-200 dark:border-slate-800 text-center text-xs font-bold text-slate-500 py-2.5">
                            ${dayNames.map(dn => `<div>${dn}</div>`).join('')}
                        </div>
                        <div class="grid grid-cols-7">${cells}</div>
                    </div>
                </div>
            </div>
            
            <!-- Quick Workspace Cards di bawah kalender -->
            <div class="pt-2">
                <h3 class="font-bold text-sm mb-3">Integrasi Google Workspace & Status Brief</h3>
                ${renderPlannerWorkspaceList(items, conflictedItemIds)}
            </div>`;
        }

        function renderPlannerWorkspaceList(items, conflictedItemIds) {
            return `
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                ${items.map(item => {
                    const clash = conflictedItemIds.has(item.id);
                    const p = item.planning;
                    return `
                    <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border ${clash ? 'border-amber-400 dark:border-amber-600' : 'border-slate-200 dark:border-slate-800'} shadow-xs space-y-4">
                        <div class="flex items-start justify-between gap-2">
                            <div>
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="text-[11px] font-bold px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800">${PHASE_META[item.phase].short}</span>
                                    ${p.needsBriefRevision ? `<span class="text-[11px] font-bold px-2 py-0.5 rounded bg-rose-100 text-rose-700 dark:bg-rose-950 dark:text-rose-300">Perlu Revisi Konsep!</span>` : `<span class="text-[11px] font-semibold px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300">Konsep Siap</span>`}
                                    ${clash ? `<span class="text-[11px] font-bold px-2 py-0.5 rounded bg-amber-100 text-amber-800">Kru Bentrok</span>` : ''}
                                </div>
                                <h4 class="font-bold text-base mt-1.5 cursor-pointer hover:text-brand-600" onclick="openDetailDrawer('${item.id}', 2)">${escapeHtml(item.title)}</h4>
                            </div>
                            <button onclick="openDetailDrawer('${item.id}', 2)" class="p-2 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700" title="Edit Brief & Jadwal">
                                <i data-lucide="sliders-horizontal" class="w-4 h-4"></i>
                            </button>
                        </div>

                        ${p.needsBriefRevision ? `
                        <div class="p-3 rounded-xl bg-rose-50 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-800/60 text-xs text-rose-800 dark:text-rose-200">
                            <strong>Catatan Revisi Konsep:</strong> ${escapeHtml(p.briefRevisionNote || 'Perlu penyesuaian outline & script.')}
                        </div>` : ''}

                        <div class="grid grid-cols-2 gap-3 text-xs bg-slate-50 dark:bg-slate-950/50 p-3 rounded-xl">
                            <div>
                                <span class="text-slate-400 block">Tanggal Take & Kru</span>
                                <strong class="text-slate-800 dark:text-slate-200">${formatDateID(p.takeDate)}</strong>
                                <div class="text-slate-500 mt-0.5 truncate" title="${escapeHtml((p.crew || []).join(', '))}">${escapeHtml((p.crew || []).join(', ') || 'Belum ada kru')}</div>
                            </div>
                            <div>
                                <span class="text-slate-400 block">Tayang Prime Time</span>
                                <strong class="text-slate-800 dark:text-slate-200">${formatDateID(p.publishDate)} (${p.publishTime || '19:00'})</strong>
                                <div class="text-slate-500 mt-0.5 truncate">${escapeHtml(p.location || 'Lokasi belum diisi')}</div>
                            </div>
                        </div>

                        <!-- Sub-Sistem Integrasi Google Workspace -->
                        <div class="space-y-2">
                            <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Sub-Sistem Integrasi Google Workspace</div>
                            <div class="flex flex-wrap gap-2">
                                <button onclick="syncGoogleCalendar('${item.id}')" class="px-3 py-1.5 rounded-xl text-xs font-semibold border transition-all flex items-center gap-1.5 ${p.gcalSynced ? 'bg-emerald-50 border-emerald-200 text-emerald-700 dark:bg-emerald-950/40 dark:border-emerald-800 dark:text-emerald-300' : 'bg-white dark:bg-slate-800 border-slate-200 dark:border-slate-700 hover:border-brand-500'}">
                                    <i data-lucide="calendar-check" class="w-3.5 h-3.5"></i>
                                    ${p.gcalSynced ? 'Calendar Terkunci ✓' : 'Kunci Jadwal & Reminder'}
                                </button>
                                <button onclick="openGoogleMaps('${item.id}')" class="px-3 py-1.5 rounded-xl text-xs font-semibold border bg-white dark:bg-slate-800 border-slate-200 dark:border-slate-700 hover:border-cyan-500 flex items-center gap-1.5">
                                    <i data-lucide="map-pin" class="w-3.5 h-3.5 text-rose-500"></i>
                                    Rute Maps (${escapeHtml(p.travelEstimate || 'Cek')})
                                </button>
                                <button onclick="generateGoogleDrive('${item.id}')" class="px-3 py-1.5 rounded-xl text-xs font-semibold border transition-all flex items-center gap-1.5 ${p.gdriveGenerated ? 'bg-blue-50 border-blue-200 text-blue-700 dark:bg-blue-950/40 dark:border-blue-800 dark:text-blue-300' : 'bg-white dark:bg-slate-800 border-slate-200 dark:border-slate-700 hover:border-blue-500'}">
                                    <i data-lucide="folder-plus" class="w-3.5 h-3.5"></i>
                                    ${p.gdriveGenerated ? 'Drive & Sheets Sync ✓' : 'Auto-Generate Folder Aset'}
                                </button>
                            </div>
                            ${p.gdriveGenerated ? `
                            <div class="flex items-center gap-1.5 flex-wrap pt-1">
                                ${p.gdriveFolders.map(f => `<span class="text-[10px] font-mono px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-950/50 text-blue-700 dark:text-blue-300 border border-blue-200/60 dark:border-blue-800/60">📁 ${f}</span>`).join('')}
                            </div>` : ''}
                        </div>

                        ${item.phase === 2 ? `
                        <div class="pt-2 border-t border-slate-100 dark:border-slate-800 flex justify-end">
                            <button onclick="advancePhase('${item.id}', 3)" ${clash || p.needsBriefRevision ? 'disabled' : ''} class="px-4 py-2 rounded-xl text-xs font-semibold flex items-center gap-1.5 ${clash || p.needsBriefRevision ? 'bg-slate-200 text-slate-400 dark:bg-slate-800 cursor-not-allowed' : 'bg-brand-600 hover:bg-brand-700 text-white'}">
                                ${clash ? 'Selesaikan Bentrok Dulu' : (p.needsBriefRevision ? 'Selesaikan Revisi Brief' : 'Kirim ke Fase 3: Produksi →')}
                            </button>
                        </div>` : ''}
                    </div>`;
                }).join('')}
            </div>`;
        }

        /* =====================================================================
           8. INTEGRASI GOOGLE WORKSPACE ACTIONS
           ===================================================================== */
        function syncGoogleCalendar(itemId) {
            const item = appState.items.find(i => i.id === itemId);
            if (!item) return;

            const takeDate = (item.planning.takeDate || '2026-12-01').replace(/-/g, '');
            const title = encodeURIComponent(`[PRFlow Take] ${item.title}`);
            const details = encodeURIComponent(`Kampanye: ${item.campaign}\nKru: ${(item.planning.crew || []).join(', ')}\nBrief: ${item.planning.brief}`);
            const location = encodeURIComponent(item.planning.location || 'Jakarta');
            const gcalUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${title}&dates=${takeDate}T090000/${takeDate}T120000&details=${details}&location=${location}`;

            item.planning.gcalSynced = true;
            saveState();
            window.open(gcalUrl, '_blank', 'noopener,noreferrer');
            showToast('success', 'Google Calendar Tersinkronisasi', `Jadwal take "${item.title}" dikunci & tab Google Calendar dibuka.`);
            renderCurrentView();
            if (activeDetailId === itemId) renderDrawerContent();
        }

        function openGoogleMaps(itemId) {
            const item = appState.items.find(i => i.id === itemId);
            if (!item) return;
            const loc = encodeURIComponent(item.planning.location || 'Jakarta');
            window.open(`https://www.google.com/maps/search/?api=1&query=${loc}`, '_blank', 'noopener,noreferrer');
            showToast('info', 'Membuka Google Maps', `Menampilkan rute menuju ${item.planning.location || 'Lokasi Take'}.`);
        }

        function generateGoogleDrive(itemId) {
            const item = appState.items.find(i => i.id === itemId);
            if (!item) return;
            item.planning.gdriveGenerated = true;
            item.planning.gdriveFolders = ['01_Brief', '02_Raw_Footage', '03_Final_Asset'];
            saveState();
            addNotification('info', 'Folder Google Drive Dibuat', `Struktur folder aset untuk "${item.title}" berhasil dibuat & tersinkron ke Sheets Tracker.`);
            showToast('success', 'Google Drive & Sheets Sync', 'Folder 01_Brief, 02_Raw_Footage, 03_Final_Asset berhasil dibuat!');
            renderCurrentView();
            if (activeDetailId === itemId) renderDrawerContent();
        }

        /* =====================================================================
           9. VIEW: FASE 3 — PRODUKSI, QC & APPROVAL (KANBAN BOARD)
           ===================================================================== */
        function renderPhase3(container) {
            const items = getFilteredItems().filter(i => i.phase === 3 || i.phase === 2);

            container.innerHTML = `
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400 mb-1">
                            <i data-lucide="clapperboard" class="w-4 h-4"></i> Fase 3 Flowchart
                        </div>
                        <h2 class="text-2xl font-bold tracking-tight">Produksi, QC Teknis & PR Brand Safety</h2>
                        <p class="text-sm text-slate-500 dark:text-slate-400">Seret kartu antar kolom atau klik tombol aksi untuk menjalankan checklist pra-produksi, QC Brand Safety, serta loop Approval & Revisi.</p>
                    </div>
                </div>

                <!-- Kanban Horizontal Board -->
                <div class="flex gap-4 overflow-x-auto pb-4 items-start">
                    ${KANBAN_STAGES.map(stage => {
                        const colItems = items.filter(i => i.phase === 3 && i.production.stage === stage.id);
                        return `
                        <div class="w-80 shrink-0 rounded-2xl bg-slate-100/80 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 p-3 flex flex-col gap-3 kanban-col transition-colors"
                             ondragover="event.preventDefault(); this.classList.add('drag-over')"
                             ondragleave="this.classList.remove('drag-over')"
                             ondrop="handleKanbanDrop(event, '${stage.id}', this)">
                            
                            <div class="flex items-center justify-between px-1">
                                <span class="text-xs font-bold px-2.5 py-1 rounded-lg ${stage.badge}">${stage.label}</span>
                                <span class="text-xs font-bold text-slate-500">${colItems.length}</span>
                            </div>

                            <div class="space-y-3 flex-1">
                                ${colItems.length === 0 ? `
                                <div class="p-6 rounded-xl border border-dashed border-slate-300 dark:border-slate-700 text-center text-xs text-slate-400">
                                    Kosong — seret kartu ke sini
                                </div>` : colItems.map(item => renderKanbanCard(item, stage.id)).join('')}
                            </div>
                        </div>`;
                    }).join('')}
                </div>
            `;
        }

        function renderKanbanCard(item, stageId) {
            const prod = item.production;
            const preDone = Object.values(prod.preProdChecklist).filter(Boolean).length;
            const qcDone = Object.values(prod.qcChecklist).filter(Boolean).length;

            return `
            <div draggable="true" ondragstart="handleKanbanDragStart(event, '${item.id}')" class="p-4 rounded-xl bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 shadow-xs hover:border-brand-500 transition-all space-y-3 cursor-grab active:cursor-grabbing">
                <div class="flex items-start justify-between gap-2">
                    <span class="px-2 py-0.5 text-[10px] font-bold rounded border ${pesoBadgeClass(item.research.peso)}">${item.research.peso}</span>
                    <button onclick="openDetailDrawer('${item.id}', 3)" class="text-xs text-brand-600 dark:text-brand-400 font-semibold hover:underline">Buka Detail</button>
                </div>
                
                <h4 class="font-bold text-sm text-slate-900 dark:text-white leading-snug cursor-pointer" onclick="openDetailDrawer('${item.id}', 3)">${escapeHtml(item.title)}</h4>
                <div class="text-[11px] text-slate-500">${escapeHtml(item.campaign)}</div>

                <!-- Checklist Indicator -->
                <div class="grid grid-cols-2 gap-2 text-[11px]">
                    <div class="p-2 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-100 dark:border-slate-800">
                        <span class="text-slate-400 block">Pra-Prod Alat</span>
                        <strong class="${preDone === 4 ? 'text-emerald-600' : 'text-slate-700 dark:text-slate-300'}">${preDone}/4 Selesai</strong>
                    </div>
                    <div class="p-2 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-100 dark:border-slate-800">
                        <span class="text-slate-400 block">QC Brand Safety</span>
                        <strong class="${qcDone === 4 ? 'text-emerald-600' : 'text-amber-600'}">${qcDone}/4 Lolos</strong>
                    </div>
                </div>

                ${prod.revisions.length > 0 ? `
                <div class="p-2.5 rounded-lg bg-rose-50 dark:bg-rose-950/40 border border-rose-200/70 dark:border-rose-800/60 text-[11px] text-rose-700 dark:text-rose-300">
                    <strong>Revisi Terakhir (${prod.revisions.length}):</strong> ${escapeHtml(prod.revisions[0].note)}
                </div>` : ''}

                <!-- Aksi Cepat sesuai Tahap Kanban -->
                <div class="pt-2 border-t border-slate-100 dark:border-slate-800 flex flex-wrap gap-1.5">
                    ${stageId === 'qc_safety' || stageId === 'approval' ? `
                        <button onclick="approveKanbanItem('${item.id}')" class="flex-1 px-2.5 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-[11px] font-semibold">
                            ${stageId === 'qc_safety' ? 'Lolos QC ✓' : 'Setujui Final ✓'}
                        </button>
                        <button onclick="openRevisionModal('${item.id}')" class="px-2.5 py-1.5 rounded-lg bg-rose-100 hover:bg-rose-200 text-rose-700 dark:bg-rose-950 dark:text-rose-300 text-[11px] font-semibold">
                            Tolak / Revisi
                        </button>
                    ` : stageId === 'siap_tayang' ? `
                        <button onclick="advancePhase('${item.id}', 4)" class="w-full px-3 py-1.5 rounded-lg bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold flex items-center justify-center gap-1.5">
                            Lanjut ke Fase 4: Distribusi <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                        </button>
                    ` : `
                        <button onclick="moveKanbanNext('${item.id}')" class="w-full px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-brand-600 hover:text-white text-xs font-semibold transition-colors">
                            Geser ke Tahap Berikutnya &rarr;
                        </button>
                    `}
                </div>
            </div>`;
        }

        function handleKanbanDragStart(e, itemId) {
            e.dataTransfer.setData('text/plain', itemId);
        }

        function handleKanbanDrop(e, targetStageId, colEl) {
            e.preventDefault();
            colEl.classList.remove('drag-over');
            const itemId = e.dataTransfer.getData('text/plain');
            const item = appState.items.find(i => i.id === itemId);
            if (!item) return;

            item.phase = 3;
            item.production.stage = targetStageId;
            saveState();
            renderCurrentView();
            showToast('info', 'Tahap Produksi Diperbarui', `"${item.title}" dipindahkan ke ${KANBAN_STAGES.find(s => s.id === targetStageId).label}.`);
        }

        function moveKanbanNext(itemId) {
            const item = appState.items.find(i => i.id === itemId);
            if (!item) return;
            const idx = KANBAN_STAGES.findIndex(s => s.id === item.production.stage);
            if (idx >= 0 && idx < KANBAN_STAGES.length - 1) {
                item.production.stage = KANBAN_STAGES[idx + 1].id;
                saveState();
                renderCurrentView();
                showToast('success', 'Progres Produksi', `"${item.title}" masuk ke ${KANBAN_STAGES[idx + 1].label}.`);
            }
        }

        function approveKanbanItem(itemId) {
            const item = appState.items.find(i => i.id === itemId);
            if (!item) return;

            if (item.production.stage === 'qc_safety') {
                // Tandai semua checklist QC lolos
                item.production.qcChecklist = { visualAudio: true, tonePR: true, brandSafety: true, akurasiData: true };
                item.production.stage = 'approval';
                addNotification('info', 'Lolos QC & Brand Safety', `"${item.title}" diteruskan ke Final Approval Klien/Pimpinan.`);
                showToast('success', 'Lolos QC Brand Safety', 'Kartu diteruskan ke tahap Final Approval.');
            } else if (item.production.stage === 'approval') {
                item.production.stage = 'siap_tayang';
                addNotification('success', 'Final Approval Disetujui!', `Aset final "${item.title}" disimpan di 03_Final_Asset Google Drive.`);
                showToast('success', 'Disetujui (Final Asset)', 'Aset disimpan ke 03_Final_Asset dan siap masuk Fase 4 Distribusi.');
            }
            saveState();
            renderCurrentView();
            if (activeDetailId === itemId) renderDrawerContent();
        }

        function openRevisionModal(itemId) {
            pendingRevisionItemId = itemId;
            document.getElementById('revision-note-input').value = '';
            const modal = document.getElementById('revision-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            lucide.createIcons();
        }

        function closeRevisionModal() {
            pendingRevisionItemId = null;
            const modal = document.getElementById('revision-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function submitRevisionNote() {
            const note = document.getElementById('revision-note-input').value.trim();
            if (!note) {
                showToast('warning', 'Catatan Kosong', 'Harap isi catatan revisi terlebih dahulu.');
                return;
            }
            const item = appState.items.find(i => i.id === pendingRevisionItemId);
            if (!item) return;

            const nowStr = new Date().toLocaleString('id-ID', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
            item.production.revisions.unshift({ date: nowStr, by: 'PR Manager / Klien', note });
            item.production.stage = 'editing'; // Loop kembali ke Editing sesuai flowchart!
            saveState();

            addNotification('warning', 'Notifikasi Gmail & Sheets: Revisi Diminta', `"${item.title}" dikembalikan ke Editing. Catatan: ${note}`);
            showToast('warning', 'Revisi Dikirim (Simulasi Gmail + Sheets)', `Kartu dikembalikan ke tahap Editing & Copywriting.`);

            closeRevisionModal();
            renderCurrentView();
            if (activeDetailId === item.id) renderDrawerContent();
        }

        /* =====================================================================
           10. VIEW: FASE 4 — DISTRIBUSI & MONITORING REAL-TIME
           ===================================================================== */
        function renderPhase4(container) {
            const items = getFilteredItems().filter(i => i.phase === 4 || (i.phase === 3 && i.production.stage === 'siap_tayang') || i.distribution.published);

            container.innerHTML = `
                <div>
                    <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-sky-600 dark:text-sky-400 mb-1">
                        <i data-lucide="radio" class="w-4 h-4"></i> Fase 4 Flowchart
                    </div>
                    <h2 class="text-2xl font-bold tracking-tight">Distribusi Multi-Kanal & Monitoring Real-Time</h2>
                    <p class="text-sm text-slate-500 dark:text-slate-400">Antrean publikasi Prime Time sesuai strategi PESO, pemantauan sentimen publik, dan Community Management.</p>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
                    ${items.length === 0 ? `
                    <div class="lg:col-span-2 p-10 rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 text-center text-sm text-slate-500">
                        Belum ada konten di Fase 4. Selesaikan tahap Final Approval di Fase 3 terlebih dahulu.
                    </div>` : items.map(item => {
                        const d = item.distribution;
                        const s = d.sentiment;
                        return `
                        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs space-y-4">
                            <div class="flex items-start justify-between gap-3">
                                <div>
