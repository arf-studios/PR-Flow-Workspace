        /* =====================================================================
           3. UTILITAS DETEKSI BENTROK JADWAL, FILTER & HELPER
           ===================================================================== */
        function detectScheduleConflicts() {
            const scheduleMap = new Map();
            const conflicts = [];
            const conflictedItemIds = new Set();

            appState.items.forEach(item => {
                const takeDate = item.planning && item.planning.takeDate;
                const crewList = (item.planning && item.planning.crew) || [];
                if (!takeDate || crewList.length === 0) return;

                crewList.forEach(member => {
                    const key = `${takeDate}__${member.trim().toLowerCase()}`;
                    if (!scheduleMap.has(key)) {
                        scheduleMap.set(key, { date: takeDate, member: member.trim(), items: [] });
                    }
                    scheduleMap.get(key).items.push(item);
                });
            });

            scheduleMap.forEach(entry => {
                if (entry.items.length > 1) {
                    conflicts.push(entry);
                    entry.items.forEach(i => conflictedItemIds.add(i.id));
                }
            });

            return { conflicts, conflictedItemIds };
        }

        function getFilteredItems() {
            const q = (document.getElementById('global-search')?.value || '').toLowerCase().trim();
            const camp = document.getElementById('campaign-filter')?.value || 'ALL';

            return appState.items.filter(item => {
                const matchCamp = camp === 'ALL' || item.campaign === camp;
                if (!matchCamp) return false;
                if (!q) return true;
                const haystack = [
                    item.title,
                    item.campaign,
                    item.research.pillar,
                    item.research.peso,
                    item.research.issueAudit,
                    item.planning.location,
                    ...(item.planning.crew || [])
                ].join(' ').toLowerCase();
                return haystack.includes(q);
            });
        }

        function updateCampaignFilterOptions() {
            const select = document.getElementById('campaign-filter');
            if (!select) return;
            const currentVal = select.value;
            const campaigns = [...new Set(appState.items.map(i => i.campaign).filter(Boolean))];
            select.innerHTML = `<option value="ALL">Semua Kampanye (${appState.items.length})</option>` +
                campaigns.map(c => `<option value="${escapeHtml(c)}" ${c === currentVal ? 'selected' : ''}>${escapeHtml(c)}</option>`).join('');
        }

        function updateSidebarBadges() {
            for (let p = 1; p <= 5; p++) {
                const el = document.getElementById(`badge-phase${p}`);
                if (el) el.textContent = appState.items.filter(i => i.phase === p).length;
            }
            const arcEl = document.getElementById('badge-archive');
            if (arcEl) arcEl.textContent = appState.archive.length;
