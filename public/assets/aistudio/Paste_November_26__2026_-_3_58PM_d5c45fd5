                </div>
                <button onclick="closeDetailDrawer()" class="p-2 rounded-xl text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 shrink-0">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            `;

            // Visual Flowchart Stepper
            document.getElementById('drawer-stepper').innerHTML = `
                <div class="flex items-center justify-between gap-2 min-w-[520px]">
                    ${[1, 2, 3, 4, 5].map(p => {
                        const done = item.phase > p;
                        const current = item.phase === p;
                        return `
                        <button onclick="advancePhase('${item.id}', ${p}, true)" class="flex-1 flex items-center gap-2 p-2 rounded-xl border text-left transition-all ${
                            current ? 'bg-brand-50 border-brand-400 dark:bg-brand-950/60 dark:border-brand-600' :
                            done ? 'bg-emerald-50/70 border-emerald-200 dark:bg-emerald-950/30 dark:border-emerald-800' :
                            'bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-800 opacity-70 hover:opacity-100'
                        }">
                            <div class="w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold shrink-0 ${
                                current ? 'bg-brand-600 text-white' : done ? 'bg-emerald-500 text-white' : 'bg-slate-200 dark:bg-slate-800 text-slate-500'
                            }">${done ? '✓' : p}</div>
                            <div class="min-w-0">
                                <div class="text-[10px] font-bold uppercase text-slate-400">Fase ${p}</div>
                                <div class="text-[11px] font-semibold truncate">${PHASE_META[p].name.split(' ')[0]}</div>
                            </div>
                        </button>`;
                    }).join('')}
                </div>
            `;

            // Tabs
            document.getElementById('drawer-tabs').innerHTML = [1, 2, 3, 4, 5].map(t => `
                <button onclick="switchDrawerTab(${t})" class="px-3.5 py-3 text-xs font-semibold border-b-2 whitespace-nowrap transition-colors ${
                    activeDrawerTab === t
                        ? 'border-brand-600 text-brand-600 dark:text-brand-400'
                        : 'border-transparent text-slate-500 hover:text-slate-800 dark:hover:text-slate-200'
                }">
                    ${t}. ${PHASE_META[t].name.split('&')[0]}
                </button>
            `).join('');

            // Body sesuai tab aktif
            const body = document.getElementById('drawer-body');
            if (activeDrawerTab === 1) body.innerHTML = renderDrawerTab1(item);
            if (activeDrawerTab === 2) body.innerHTML = renderDrawerTab2(item);
            if (activeDrawerTab === 3) body.innerHTML = renderDrawerTab3(item);
            if (activeDrawerTab === 4) body.innerHTML = renderDrawerTab4(item);
            if (activeDrawerTab === 5) body.innerHTML = renderDrawerTab5(item);

            // Footer
            document.getElementById('drawer-footer').innerHTML = `
                <button onclick="confirmDeleteItem('${item.id}')" class="px-3.5 py-2 rounded-xl text-xs font-semibold text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 flex items-center gap-1.5">
                    <i data-lucide="trash-2" class="w-4 h-4"></i> Hapus Konten
                </button>
                <div class="flex items-center gap-2">
                    <button onclick="closeDetailDrawer()" class="px-4 py-2 rounded-xl text-xs font-semibold bg-slate-200 dark:bg-slate-800 hover:bg-slate-300 dark:hover:bg-slate-700">Tutup</button>
                    <button onclick="saveDrawerChanges()" class="px-5 py-2 rounded-xl text-xs font-semibold bg-brand-600 hover:bg-brand-700 text-white shadow-sm flex items-center gap-1.5">
                        <i data-lucide="save" class="w-3.5 h-3.5"></i> Simpan Perubahan
                    </button>
                </div>
            `;

            lucide.createIcons();
        }

