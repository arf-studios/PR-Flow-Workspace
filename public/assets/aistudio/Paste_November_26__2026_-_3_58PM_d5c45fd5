        function fillDemoCredentials(prefix) {
            document.getElementById(`${prefix}-ws-id`).value = DEMO_ACCOUNT.workspaceId;
            document.getElementById(`${prefix}-email`).value = DEMO_ACCOUNT.email;
            document.getElementById(`${prefix}-password`).value = DEMO_ACCOUNT.password;
            document.getElementById(`${prefix}-role`).value = DEMO_ACCOUNT.role;
            const errBox = document.getElementById(`${prefix}-auth-error`);
            if (errBox) errBox.classList.add('hidden');
            showToast('info', 'Kredensial Demo Terisi', 'Klik "Masuk ke PRFlow Workspace" untuk verifikasi keamanan.');
        }

        function handleAgencyLogin(e, prefix) {
            e.preventDefault();
            const wsId = document.getElementById(`${prefix}-ws-id`).value.trim().toUpperCase();
            const email = document.getElementById(`${prefix}-email`).value.trim().toLowerCase();
            const pass = document.getElementById(`${prefix}-password`).value;
            const role = document.getElementById(`${prefix}-role`).value;
            const remember = document.getElementById(`${prefix}-remember`).checked;
            const errBox = document.getElementById(`${prefix}-auth-error`);
            const submitBtn = document.getElementById(`${prefix}-submit-btn`);

            if (!wsId || !email || !pass) {
                errBox.textContent = 'Harap lengkapi Agency Workspace ID, Email Agensi, dan Password.';
                errBox.classList.remove('hidden');
                return;
            }

            // Cek Demo Account atau Registered Users
            const registered = getRegisteredUsers();
            const matchedReg = registered.find(u => u.email.toLowerCase() === email && u.password === pass && u.workspaceId.toUpperCase() === wsId);
            const isDemoMatch = (wsId === DEMO_ACCOUNT.workspaceId && email === DEMO_ACCOUNT.email && pass === DEMO_ACCOUNT.password);

            if (!isDemoMatch && !matchedReg) {
                errBox.textContent = 'Kredensial tidak valid. Gunakan tombol "1-Klik Isi Akun Demo" atau daftar akun baru di tab Daftar Tim Agency.';
                errBox.classList.remove('hidden');
                return;
            }

            errBox.classList.add('hidden');
            submitBtn.disabled = true;
            submitBtn.innerHTML = `<span class="w-4 h-4 border-2 border-white/40 border-t-white rounded-full animate-spin"></span> Memverifikasi Kredensial & Enkripsi Sesi...`;

            setTimeout(() => {
                const sessionObj = {
                    workspaceId: wsId,
                    email,
                    name: matchedReg ? matchedReg.name : DEMO_ACCOUNT.name,
                    role,
                    loginAt: new Date().toISOString()
                };
                currentSession = sessionObj;
                if (remember) {
                    localStorage.setItem(AUTH_SESSION_KEY, JSON.stringify(sessionObj));
                } else {
                    sessionStorage.setItem(AUTH_SESSION_KEY, JSON.stringify(sessionObj));
                }

                closeLoginModal();
                showWorkspaceView();
                showToast('success', `Selamat Datang, ${sessionObj.name}!`, `Sesi terenkripsi aktif sebagai ${sessionObj.role} (${sessionObj.workspaceId}).`);
            }, 850);
        }

        function handleAgencyRegister(e, prefix) {
            e.preventDefault();
            const name = document.getElementById(`${prefix}-reg-name`).value.trim();
            const wsId = document.getElementById(`${prefix}-reg-ws`).value.trim().toUpperCase();
            const role = document.getElementById(`${prefix}-reg-role`).value;
            const email = document.getElementById(`${prefix}-reg-email`).value.trim().toLowerCase();
            const password = document.getElementById(`${prefix}-reg-pass`).value;

            const newUser = { name, workspaceId: wsId, role, email, password };
            saveRegisteredUser(newUser);

            currentSession = { workspaceId: wsId, email, name, role, loginAt: new Date().toISOString() };
            localStorage.setItem(AUTH_SESSION_KEY, JSON.stringify(currentSession));

            closeLoginModal();
            showWorkspaceView();
            showToast('success', 'Akun Tim Agency Terdaftar!', `Selamat datang ${name} (${role}). Workspace siap digunakan.`);
        }

