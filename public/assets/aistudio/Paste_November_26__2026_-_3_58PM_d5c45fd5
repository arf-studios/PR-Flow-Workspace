<!DOCTYPE html>
<html lang="id" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PRFlow Workspace — PR Agency Content Planner & Command Center</title>
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            200: '#c7d2fe',
                            300: '#a5b4fc',
                            400: '#818cf8',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            800: '#3730a3',
                            900: '#312e81',
                        }
                    }
                }
            }
        }
    </script>
    
    <!-- Lucide Icons CDN -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <style>
        /* Custom scrollbar untuk tampilan rapi seperti Notion/Linear */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(148, 163, 184, 0.35);
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(100, 116, 139, 0.6);
        }
        
        /* Animasi halus untuk drawer & modal */
        .slide-over-enter {
            transform: translateX(0);
            opacity: 1;
        }
        .slide-over-exit {
            transform: translateX(100%);
            opacity: 0;
        }
        .kanban-col {
            min-height: 420px;
        }
        .drag-over {
            border-color: #6366f1 !important;
            background-color: rgba(99, 102, 241, 0.06) !important;
        }
        /* Animasi halus untuk landing page */
        .fade-in-section {
            animation: fadeInUp 0.35s ease-out;
        }
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-100 font-sans antialiased selection:bg-brand-500 selection:text-white overflow-x-hidden">

    <!-- =====================================================================
         BAGIAN 1: HALAMAN DEPAN (LANDING PAGE) & PORTAL LOGIN PR AGENCY
         ===================================================================== -->
    <div id="landing-shell" class="min-h-screen flex flex-col bg-slate-50 dark:bg-slate-950">
        
        <!-- Sticky Glassmorphism Top Navigation Bar -->
        <header class="sticky top-0 z-40 bg-white/80 dark:bg-slate-950/80 backdrop-blur-lg border-b border-slate-200/80 dark:border-slate-800/80">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
                <!-- Brand Logo -->
                <button onclick="switchLandingTab('home')" class="flex items-center gap-3 text-left group">
                    <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-brand-600 to-violet-600 flex items-center justify-center text-white shadow-md shadow-brand-500/25 group-hover:scale-105 transition-transform">
                        <i data-lucide="layers" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <div class="font-extrabold text-base tracking-tight text-slate-900 dark:text-white leading-none">PRFlow</div>
                        <div class="text-[10px] font-semibold text-brand-600 dark:text-brand-400 tracking-wide uppercase mt-0.5">PR Agency Command Center</div>
                    </div>
                </button>

                <!-- Desktop Navigation Tabs -->
                <nav class="hidden md:flex items-center gap-1 bg-slate-100/80 dark:bg-slate-900/80 p-1 rounded-2xl border border-slate-200/70 dark:border-slate-800">
                    <button onclick="switchLandingTab('home')" data-ltab="home" class="ltab-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all">Beranda</button>
                    <button onclick="switchLandingTab('about')" data-ltab="about" class="ltab-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all">About Us</button>
                    <button onclick="switchLandingTab('features')" data-ltab="features" class="ltab-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all">Solusi & Fitur</button>
                    <button onclick="switchLandingTab('news')" data-ltab="news" class="ltab-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all">News & Blog</button>
                    <button onclick="switchLandingTab('contact')" data-ltab="contact" class="ltab-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all">Kontak & Demo</button>
                </nav>

                <!-- Right Actions -->
                <div class="flex items-center gap-2">
                    <button onclick="toggleTheme()" class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors" title="Ganti Tema">
                        <i id="landing-theme-icon" data-lucide="moon" class="w-4 h-4"></i>
                    </button>

                    <!-- Tombol Dinamis: Login Agency ATAU Kembali ke Workspace jika sudah login -->
                    <button id="landing-cta-auth-btn" onclick="handleLandingAuthCTA()" class="px-4 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs sm:text-sm font-semibold shadow-sm shadow-brand-500/25 flex items-center gap-2 transition-all active:scale-95">
                        <i data-lucide="shield-check" class="w-4 h-4"></i>
                        <span id="landing-cta-auth-text">Login Agency</span>
                    </button>

                    <!-- Mobile Menu Toggle -->
                    <button onclick="toggleLandingMobileMenu()" class="md:hidden p-2.5 rounded-xl bg-slate-100 dark:bg-slate-900 text-slate-600 dark:text-slate-300">
                        <i data-lucide="menu" class="w-4 h-4"></i>
                    </button>
                </div>
            </div>

            <!-- Mobile Nav Drawer -->
            <div id="landing-mobile-menu" class="hidden md:hidden border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 px-4 py-3 space-y-1">
                <button onclick="switchLandingTab('home'); toggleLandingMobileMenu(false)" data-ltab="home" class="ltab-btn w-full text-left px-3.5 py-2 rounded-xl text-sm font-semibold">Beranda</button>
                <button onclick="switchLandingTab('about'); toggleLandingMobileMenu(false)" data-ltab="about" class="ltab-btn w-full text-left px-3.5 py-2 rounded-xl text-sm font-semibold">About Us</button>
                <button onclick="switchLandingTab('features'); toggleLandingMobileMenu(false)" data-ltab="features" class="ltab-btn w-full text-left px-3.5 py-2 rounded-xl text-sm font-semibold">Solusi & Fitur</button>
                <button onclick="switchLandingTab('news'); toggleLandingMobileMenu(false)" data-ltab="news" class="ltab-btn w-full text-left px-3.5 py-2 rounded-xl text-sm font-semibold">News & Blog</button>
                <button onclick="switchLandingTab('contact'); toggleLandingMobileMenu(false)" data-ltab="contact" class="ltab-btn w-full text-left px-3.5 py-2 rounded-xl text-sm font-semibold">Kontak & Demo</button>
            </div>
        </header>

        <!-- Dynamic Landing Page Content Area -->
        <main id="landing-main" class="flex-1">
            <!-- Dirender dinamis oleh JavaScript sesuai tab aktif -->
        </main>

        <!-- Landing Footer -->
        <footer class="bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 mt-16">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex flex-col md:flex-row items-center justify-between gap-6">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-brand-600 to-violet-600 flex items-center justify-center text-white">
                        <i data-lucide="layers" class="w-4 h-4"></i>
                    </div>
                    <div>
                        <div class="font-bold text-sm text-slate-900 dark:text-white">PRFlow Workspace</div>
                        <div class="text-xs text-slate-500 dark:text-slate-400">Standar Baru Manajemen Konten & Reputasi PR Agency Indonesia.</div>
                    </div>
                </div>
                <div class="flex flex-wrap items-center justify-center gap-5 text-xs font-medium text-slate-500 dark:text-slate-400">
                    <button onclick="switchLandingTab('home')" class="hover:text-brand-600">Beranda</button>
                    <button onclick="switchLandingTab('about')" class="hover:text-brand-600">About Us</button>
                    <button onclick="switchLandingTab('features')" class="hover:text-brand-600">Solusi & Fitur</button>
                    <button onclick="switchLandingTab('news')" class="hover:text-brand-600">News & Blog</button>
                    <button onclick="switchLandingTab('contact')" class="hover:text-brand-600">Kontak & Demo</button>
                </div>
                <div class="text-xs text-slate-400">&copy; 2026 PRFlow Agency Systems. Terenkripsi SSL/TLS.</div>
            </div>
        </footer>
    </div>

    <!-- MODAL: LOGIN KEAMANAN PR AGENCY (Dapat dibuka dari tab mana saja) -->
    <div id="login-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-900/70 backdrop-blur-sm">
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl shadow-2xl w-full max-w-md overflow-hidden relative">
            <button onclick="closeLoginModal()" class="absolute top-4 right-4 p-2 rounded-xl text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 z-10">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
            <div id="login-modal-body" class="p-6 sm:p-7">
                <!-- Diisi oleh renderAuthCardHTML('modal') -->
            </div>
        </div>
    </div>

    <!-- MODAL: BLOG & NEWS READER -->
    <div id="blog-reader-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-900/70 backdrop-blur-sm">
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl shadow-2xl w-full max-w-2xl max-h-[88vh] flex flex-col overflow-hidden">
            <div id="blog-reader-header" class="px-6 py-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between gap-4 shrink-0">
                <!-- Diisi JS -->
            </div>
            <div id="blog-reader-body" class="p-6 overflow-y-auto space-y-4 text-sm leading-relaxed text-slate-700 dark:text-slate-300">
                <!-- Diisi JS -->
            </div>
            <div id="blog-reader-footer" class="px-6 py-4 border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950/60 flex items-center justify-between shrink-0">
                <!-- Diisi JS -->
            </div>
        </div>
    </div>

    <!-- =====================================================================
         BAGIAN 2: APP SHELL WORKSPACE (TERKUNCI SEBELUM LOGIN)
         ===================================================================== -->
    <div id="workspace-shell" class="hidden flex h-screen overflow-hidden">
        
        <!-- Mobile Sidebar Backdrop -->
        <div id="sidebar-backdrop" onclick="toggleMobileSidebar(false)" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-40 hidden lg:hidden transition-opacity"></div>

        <!-- ================= SIDEBAR NAVIGASI ================= -->
        <aside id="sidebar" class="fixed lg:static inset-y-0 left-0 z-50 w-72 bg-white dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800 flex flex-col transform -translate-x-full lg:translate-x-0 transition-transform duration-200 ease-in-out shrink-0">
            
            <!-- Brand Header -->
            <div class="h-16 px-5 flex items-center justify-between border-b border-slate-200 dark:border-slate-800">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-brand-600 to-violet-600 flex items-center justify-center text-white shadow-md shadow-brand-500/20">
                        <i data-lucide="layers" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <h1 class="font-bold text-sm tracking-tight text-slate-900 dark:text-white leading-tight">PRFlow Workspace</h1>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400 font-medium">PR Content Planner Manager</p>
                    </div>
                </div>
                <button onclick="toggleMobileSidebar(false)" class="lg:hidden p-1.5 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- Navigation Links -->
            <nav class="flex-1 overflow-y-auto p-3 space-y-1">
                <div class="px-3 pt-2 pb-1 text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Utama</div>
                
                <button onclick="navigateTo('dashboard')" data-nav="dashboard" class="nav-item w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium transition-all">
                    <span class="flex items-center gap-3">
                        <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
                        Dashboard & Alur Kerja
                    </span>
                </button>

                <div class="px-3 pt-4 pb-1 text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">5 Fase PR Flowchart</div>

                <button onclick="navigateTo('phase1')" data-nav="phase1" class="nav-item w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium transition-all">
                    <span class="flex items-center gap-3">
                        <i data-lucide="compass" class="w-4 h-4 text-fuchsia-500"></i>
                        <span class="truncate">Fase 1: Riset & PESO</span>
                    </span>
                    <span id="badge-phase1" class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">0</span>
                </button>

                <button onclick="navigateTo('phase2')" data-nav="phase2" class="nav-item w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium transition-all">
                    <span class="flex items-center gap-3">
                        <i data-lucide="calendar-days" class="w-4 h-4 text-cyan-500"></i>
                        <span class="truncate">Fase 2: Planner & Kalender</span>
                    </span>
                    <span id="badge-phase2" class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">0</span>
                </button>

                <button onclick="navigateTo('phase3')" data-nav="phase3" class="nav-item w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium transition-all">
                    <span class="flex items-center gap-3">
                        <i data-lucide="clapperboard" class="w-4 h-4 text-amber-500"></i>
                        <span class="truncate">Fase 3: Produksi & QC</span>
                    </span>
                    <span id="badge-phase3" class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">0</span>
                </button>

                <button onclick="navigateTo('phase4')" data-nav="phase4" class="nav-item w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium transition-all">
                    <span class="flex items-center gap-3">
                        <i data-lucide="radio" class="w-4 h-4 text-sky-500"></i>
                        <span class="truncate">Fase 4: Distribusi & Monitor</span>
                    </span>
                    <span id="badge-phase4" class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">0</span>
                </button>

                <button onclick="navigateTo('phase5')" data-nav="phase5" class="nav-item w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium transition-all">
                    <span class="flex items-center gap-3">
                        <i data-lucide="bar-chart-3" class="w-4 h-4 text-emerald-500"></i>
                        <span class="truncate">Fase 5: Evaluasi & Krisis</span>
                    </span>
                    <span id="badge-phase5" class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">0</span>
                </button>

                <div class="px-3 pt-4 pb-1 text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Repositori</div>

                <button onclick="navigateTo('archive')" data-nav="archive" class="nav-item w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium transition-all">
                    <span class="flex items-center gap-3">
                        <i data-lucide="archive" class="w-4 h-4 text-slate-500"></i>
                        <span class="truncate">Arsip Pembelajaran</span>
                    </span>
                    <span id="badge-archive" class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">0</span>
                </button>
            </nav>

            <!-- User Agency Session Card -->
            <div id="sidebar-user-card" class="mx-3 mb-2 p-3 rounded-2xl bg-slate-50 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800">
                <!-- Diisi JS sesuai sesi user login -->
            </div>

            <!-- Sidebar Footer Tools -->
            <div class="p-3 border-t border-slate-200 dark:border-slate-800 space-y-2">
                <button onclick="exportToCSV()" class="w-full flex items-center justify-center gap-2 px-3 py-2 rounded-xl text-xs font-semibold bg-emerald-50 text-emerald-700 hover:bg-emerald-100 dark:bg-emerald-950/50 dark:text-emerald-300 dark:hover:bg-emerald-900/50 border border-emerald-200/70 dark:border-emerald-800/60 transition-colors">
                    <i data-lucide="file-spreadsheet" class="w-4 h-4"></i>
                    Export Laporan CSV (Sheets)
                </button>
                <div class="grid grid-cols-2 gap-1.5">
                    <button onclick="previewLandingPage()" class="flex items-center justify-center gap-1.5 px-2.5 py-2 rounded-xl text-[11px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
                        <i data-lucide="globe" class="w-3.5 h-3.5"></i>
                        Landing
                    </button>
                    <button onclick="logoutWorkspace()" class="flex items-center justify-center gap-1.5 px-2.5 py-2 rounded-xl text-[11px] font-semibold bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 hover:bg-rose-100 dark:hover:bg-rose-900/60 border border-rose-200/60 dark:border-rose-900/60 transition-colors">
                        <i data-lucide="log-out" class="w-3.5 h-3.5"></i>
                        Logout
                    </button>
                </div>
                <button onclick="openResetConfirm()" class="w-full flex items-center justify-center gap-2 px-3 py-1.5 rounded-xl text-[11px] font-medium text-slate-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:text-rose-400 dark:hover:bg-rose-950/30 transition-colors">
                    <i data-lucide="rotate-ccw" class="w-3 h-3"></i>
                    Reset Data Demo
                </button>
            </div>
        </aside>

        <!-- ================= MAIN WORKSPACE AREA ================= -->
        <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
            
            <!-- TOP BAR -->
            <header class="h-16 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 px-4 lg:px-6 flex items-center justify-between gap-3 shrink-0 z-30">
                
                <div class="flex items-center gap-3 flex-1 min-w-0">
                    <!-- Mobile Menu Toggle -->
                    <button onclick="toggleMobileSidebar(true)" class="lg:hidden p-2 rounded-xl text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800">
                        <i data-lucide="menu" class="w-5 h-5"></i>
                    </button>

                    <!-- Global Search -->
                    <div class="relative flex-1 max-w-md">
                        <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                        <input id="global-search" type="text" oninput="handleFilterChange()" placeholder="Cari konten, kampanye, kru, atau isu PR..." class="w-full pl-10 pr-4 py-2 text-sm bg-slate-100 dark:bg-slate-800/80 border border-transparent focus:border-brand-500 focus:bg-white dark:focus:bg-slate-900 rounded-xl outline-none transition-all placeholder:text-slate-400">
                    </div>

                    <!-- Filter Kampanye -->
                    <div class="hidden md:block">
                        <select id="campaign-filter" onchange="handleFilterChange()" class="text-sm bg-slate-100 dark:bg-slate-800/80 border border-transparent focus:border-brand-500 rounded-xl px-3 py-2 outline-none cursor-pointer text-slate-700 dark:text-slate-200">
                            <option value="ALL">Semua Kampanye</option>
                        </select>
                    </div>
                </div>

                <!-- Right Controls -->
                <div class="flex items-center gap-2 sm:gap-3 shrink-0">
                    <!-- Notification Bell -->
                    <div class="relative">
                        <button onclick="toggleNotifications()" class="relative p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors" title="Notifikasi & Log Aktivitas">
                            <i data-lucide="bell" class="w-4 h-4"></i>
                            <span id="notif-dot" class="hidden absolute top-1.5 right-1.5 w-2.5 h-2.5 rounded-full bg-rose-500 ring-2 ring-white dark:ring-slate-900"></span>
                        </button>

                        <!-- Notification Dropdown -->
                        <div id="notif-panel" class="hidden absolute right-0 mt-2 w-80 sm:w-96 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-xl z-50 overflow-hidden">
                            <div class="px-4 py-3 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
                                <span class="font-semibold text-sm">Notifikasi & Log Sistem</span>
                                <button onclick="markAllNotificationsRead()" class="text-xs text-brand-600 dark:text-brand-400 hover:underline font-medium">Tandai dibaca</button>
                            </div>
                            <div id="notif-list" class="max-h-80 overflow-y-auto divide-y divide-slate-100 dark:divide-slate-800">
                                <!-- Diisi JS -->
                            </div>
                        </div>
                    </div>

                    <!-- Dark/Light Mode Toggle -->
                    <button onclick="toggleTheme()" class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors" title="Ganti Tema">
                        <i id="theme-icon" data-lucide="moon" class="w-4 h-4"></i>
                    </button>

                    <!-- Security Status Pill & Quick Logout -->
                    <button onclick="logoutWorkspace()" class="hidden xl:flex items-center gap-1.5 px-3 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-rose-50 dark:hover:bg-rose-950/50 text-slate-600 dark:text-slate-300 hover:text-rose-600 text-xs font-semibold transition-colors" title="Kunci Sesi & Logout">
                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                        <span id="topbar-ws-id">PR-JKT-01</span>
                        <i data-lucide="lock" class="w-3.5 h-3.5 ml-1"></i>
