        function publishContentNow(itemId) {
            const item = appState.items.find(i => i.id === itemId);
            if (!item) return;
            item.phase = 4;
            item.distribution.published = true;
            if (item.distribution.sentiment.positive === 0 && item.distribution.sentiment.negative === 0) {
                item.distribution.sentiment = { positive: 72, neutral: 22, negative: 6 };
                item.distribution.mentions = 84;
            }
            item.distribution.responseStatus = 'Sedang Ditangani';
            saveState();
            addNotification('success', 'Konten Berhasil Dipublikasikan', `"${item.title}" kini live di ${(item.distribution.channels || []).join(', ')}.`);
            showToast('success', 'Publikasi Multi-Kanal Live!', 'Monitoring sentimen real-time mulai aktif.');
            renderCurrentView();
        }

        function updateResponseStatus(itemId, status) {
            const item = appState.items.find(i => i.id === itemId);
            if (!item) return;
            item.distribution.responseStatus = status;
            saveState();
            showToast('info', 'Community Management', `Status respon diubah menjadi "${status}".`);
        }

        /* =====================================================================
           11. VIEW: FASE 5 — EVALUASI, ANALITIK CHART.JS & RESPON KRISIS
