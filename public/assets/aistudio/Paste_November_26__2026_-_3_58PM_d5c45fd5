                                                <button onclick="triggerOptimizationAction('${item.id}', '${act}')" class="px-2 py-1 rounded-lg font-semibold border transition-all ${item.evaluation.actionTaken === act ? 'bg-rose-600 text-white border-rose-600' : 'bg-white dark:bg-slate-900 border-rose-200 dark:border-rose-800 text-rose-700 dark:text-rose-300 hover:bg-rose-100'}">${act}</button>
