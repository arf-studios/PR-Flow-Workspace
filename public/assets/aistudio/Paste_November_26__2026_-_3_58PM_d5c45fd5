                                            <label class="block text-[11px] font-semibold mb-1">Akar Penyebab:</label>
                                            <select onchange="updateEvalField('${item.id}', 'auditCause', this.value)" class="w-full px-2.5 py-1.5 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 outline-none">
                                                <option value="">-- Pilih Penyebab --</option>
                                                ${['Algoritma', 'Pesan', 'Waktu Tayang', 'Isu Eksternal'].map(c => `<option value="${c}" ${item.evaluation.auditCause === c ? 'selected' : ''}>${c}</option>`).join('')}
