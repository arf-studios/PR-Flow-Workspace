                                        <i data-lucide="archive" class="w-3.5 h-3.5"></i> Arsipkan Data Pembelajaran
                                    </button>
                                    <button onclick="cloneToNextCycle('${item.id}')" class="px-3.5 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold flex items-center gap-1.5">
                                        <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i> Lanjut Siklus Kampanye Berikutnya
                                    </button>
