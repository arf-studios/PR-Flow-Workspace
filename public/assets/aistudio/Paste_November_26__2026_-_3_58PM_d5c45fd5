        function switchLandingTab(tab) {
            currentLandingTab = tab;
            document.querySelectorAll('.ltab-btn').forEach(btn => {
                const active = btn.dataset.ltab === tab;
                btn.className = `ltab-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all ${
                    active
                        ? 'bg-white dark:bg-slate-800 text-brand-600 dark:text-brand-400 shadow-xs'
                        : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'
                }`;
            });

            const main = document.getElementById('landing-main');
            if (!main) return;

            if (tab === 'home') main.innerHTML = renderLandingHome();
            else if (tab === 'about') main.innerHTML = renderLandingAbout();
            else if (tab === 'features') main.innerHTML = renderLandingFeatures();
            else if (tab === 'news') main.innerHTML = renderLandingNews();
            else if (tab === 'contact') main.innerHTML = renderLandingContact();

            window.scrollTo({ top: 0, behavior: 'smooth' });
            lucide.createIcons();
        }

