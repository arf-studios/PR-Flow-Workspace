        function loadState() {
            try {
                const raw = localStorage.getItem(STORAGE_KEY);
                if (raw) {
                    const parsed = JSON.parse(raw);
                    if (parsed && Array.isArray(parsed.items)) return parsed;
                }
            } catch (e) {
                console.error('Gagal memuat state:', e);
            }
            const demo = getInitialDemoData();
            localStorage.setItem(STORAGE_KEY, JSON.stringify(demo));
            return demo;
        }

        function saveState() {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(appState));
            } catch (e) {
                console.error('Gagal menyimpan state:', e);
            }
            updateSidebarBadges();
            updateCampaignFilterOptions();
            renderNotifications();
        }

        function addNotification(type, title, message) {
            appState.notifications.unshift({
                id: 'n-' + Date.now(),
                type,
                title,
                message,
                time: 'Baru saja',
                read: false
            });
            if (appState.notifications.length > 25) appState.notifications.pop();
            saveState();
        }

        /* =====================================================================
           2B. AUTENTIKASI KEAMANAN PR AGENCY & ROUTING LANDING <-> WORKSPACE
           ===================================================================== */
        function loadAuthSession() {
            try {
                const raw = localStorage.getItem(AUTH_SESSION_KEY) || sessionStorage.getItem(AUTH_SESSION_KEY);
                if (raw) {
                    const parsed = JSON.parse(raw);
                    if (parsed && parsed.email && parsed.workspaceId) return parsed;
                }
            } catch (e) {
                console.error('Gagal memuat sesi auth:', e);
            }
            return null;
        }

        function getRegisteredUsers() {
            try {
                const raw = localStorage.getItem(REGISTERED_USERS_KEY);
                return raw ? JSON.parse(raw) : [];
            } catch (e) {
                return [];
            }
        }

        function saveRegisteredUser(user) {
            const list = getRegisteredUsers();
            list.push(user);
            localStorage.setItem(REGISTERED_USERS_KEY, JSON.stringify(list));
        }

        function showWorkspaceView() {
            document.getElementById('landing-shell').classList.add('hidden');
            document.getElementById('workspace-shell').classList.remove('hidden');
            updateWorkspaceUserUI();
            updateSidebarBadges();
            updateCampaignFilterOptions();
            renderNotifications();
            navigateTo(currentView || 'dashboard');
