                <!-- 3 Grafik Chart.js -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
                    <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs">
                        <h3 class="font-bold text-sm mb-3">Distribusi PESO Model</h3>
                        <div class="h-56 relative"><canvas id="chart-peso"></canvas></div>
                    </div>
                    <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs">
                        <h3 class="font-bold text-sm mb-3">Pencapaian KPI vs Target (%)</h3>
                        <div class="h-56 relative"><canvas id="chart-kpi"></canvas></div>
                    </div>
                    <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs">
                        <h3 class="font-bold text-sm mb-3">Tren Sentimen Publik (%)</h3>
                        <div class="h-56 relative"><canvas id="chart-sentiment"></canvas></div>
                    </div>
                </div>

                <!-- Sistem Audit KPI & Respon Krisis -->
                <div class="space-y-4">
                    <h3 class="font-bold text-base">Audit KPI Otomatis & Keputusan Optimasi</h3>
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
