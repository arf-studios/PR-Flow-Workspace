            // Render Chart.js setelah DOM masuk
            setTimeout(() => renderPhase5Charts(items), 50);
        }

        function destroyAllCharts() {
            Object.values(chartInstances).forEach(ch => {
                if (ch && typeof ch.destroy === 'function') ch.destroy();
            });
            chartInstances = {};
        }

        function renderPhase5Charts(items) {
            const isDark = document.documentElement.classList.contains('dark');
            const textColor = isDark ? '#cbd5e1' : '#475569';
            const gridColor = isDark ? 'rgba(148,163,184,0.12)' : 'rgba(148,163,184,0.2)';

            // 1. PESO Doughnut
            const ctxPeso = document.getElementById('chart-peso');
            if (ctxPeso) {
                const counts = ['Paid', 'Earned', 'Shared', 'Owned'].map(p => items.filter(i => i.research.peso === p).length);
                chartInstances.peso = new Chart(ctxPeso, {
                    type: 'doughnut',
                    data: {
                        labels: ['Paid', 'Earned', 'Shared', 'Owned'],
                        datasets: [{
                            data: counts,
                            backgroundColor: ['#f43f5e', '#10b981', '#0ea5e9', '#8b5cf6'],
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom', labels: { color: textColor, boxWidth: 12 } } }
                    }
                });
            }

            // 2. KPI vs Target (%)
            const ctxKpi = document.getElementById('chart-kpi');
            if (ctxKpi) {
                const pubItems = items.filter(i => i.distribution.published || i.phase === 5);
                const labels = pubItems.map(i => i.title.length > 16 ? i.title.slice(0, 16) + '…' : i.title);
                const actualPct = pubItems.map(i => Math.round(((Number(i.evaluation.kpiActual) || 0) / (Number(i.research.kpiTarget) || 1)) * 100));
                chartInstances.kpi = new Chart(ctxKpi, {
                    type: 'bar',
                    data: {
                        labels: labels.length ? labels : ['Belum ada data'],
                        datasets: [
                            { label: 'Capaian (%)', data: actualPct.length ? actualPct : [0], backgroundColor: '#6366f1', borderRadius: 6 },
                            { label: 'Target (100%)', data: labels.map(() => 100), backgroundColor: isDark ? '#334155' : '#e2e8f0', borderRadius: 6 }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: { beginAtZero: true, grid: { color: gridColor }, ticks: { color: textColor } },
                            x: { grid: { display: false }, ticks: { color: textColor, font: { size: 10 } } }
                        },
                        plugins: { legend: { position: 'bottom', labels: { color: textColor, boxWidth: 12 } } }
                    }
                });
            }

            // 3. Sentimen Publik
            const ctxSent = document.getElementById('chart-sentiment');
            if (ctxSent) {
                const pubItems = items.filter(i => i.distribution.published || i.phase === 5);
                const labels = pubItems.map(i => i.title.length > 14 ? i.title.slice(0, 14) + '…' : i.title);
                chartInstances.sentiment = new Chart(ctxSent, {
                    type: 'bar',
                    data: {
                        labels: labels.length ? labels : ['Belum ada data'],
                        datasets: [
                            { label: 'Positif', data: pubItems.map(i => i.distribution.sentiment.positive), backgroundColor: '#10b981', borderRadius: 4 },
                            { label: 'Netral', data: pubItems.map(i => i.distribution.sentiment.neutral), backgroundColor: '#94a3b8', borderRadius: 4 },
                            { label: 'Negatif', data: pubItems.map(i => i.distribution.sentiment.negative), backgroundColor: '#f43f5e', borderRadius: 4 }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            x: { stacked: true, grid: { display: false }, ticks: { color: textColor, font: { size: 10 } } },
                            y: { stacked: true, max: 100, grid: { color: gridColor }, ticks: { color: textColor } }
                        },
                        plugins: { legend: { position: 'bottom', labels: { color: textColor, boxWidth: 12 } } }
                    }
                });
            }
        }

        function updateEvalField(itemId, field, value) {
            const item = appState.items.find(i => i.id === itemId);
            if (!item) return;
            item.evaluation[field] = value;
            saveState();
        }

        function triggerOptimizationAction(itemId, actionName) {
            const item = appState.items.find(i => i.id === itemId);
            if (!item) return;
            item.evaluation.actionTaken = actionName;
            saveState();
            addNotification('info', `Aksi Optimasi: ${actionName}`, `Tindakan "${actionName}" telah diaktifkan untuk konten "${item.title}".`);
            showToast('success', `Aksi ${actionName} Diaktifkan`, `Rencana optimasi/respon krisis tersimpan di evaluasi.`);
            renderCurrentView();
        }

        function archiveLearning(itemId) {
            const item = appState.items.find(i => i.id === itemId);
            if (!item) return;

            const pct = Math.round(((Number(item.evaluation.kpiActual) || 0) / (Number(item.research.kpiTarget) || 1)) * 100);
            const learningNote = item.evaluation.auditNotes || item.evaluation.actionTaken
                ? `Audit: ${item.evaluation.auditCause || '-'} | Aksi: ${item.evaluation.actionTaken || '-'} | Catatan: ${item.evaluation.auditNotes || 'Tersimpan sebagai pembelajaran krisis.'}`
                : `Strategi ${item.research.peso} (${item.research.funnel}) berjalan optimal dengan sentimen positif ${item.distribution.sentiment.positive}%.`;

            appState.archive.unshift({
                id: 'arc-' + Date.now(),
                title: item.title,
                campaign: item.campaign,
                peso: item.research.peso,
                funnel: item.research.funnel,
                kpiSummary: `Tercapai ${pct}% (${Number(item.evaluation.kpiActual).toLocaleString('id-ID')} / ${Number(item.research.kpiTarget).toLocaleString('id-ID')})`,
                sentimentPositive: item.distribution.sentiment.positive,
                keyLearning: learningNote,
                archivedAt: new Date().toISOString().slice(0, 10)
            });

            item.evaluation.archived = true;
            saveState();
            showToast('success', 'Data Pembelajaran Diarsipkan', `"${item.title}" berhasil disimpan ke Arsip Pembelajaran (Google Drive).`);
            renderCurrentView();
        }

        function cloneToNextCycle(itemId) {
            const src = appState.items.find(i => i.id === itemId);
            if (!src) return;

            const cloned = JSON.parse(JSON.stringify(src));
            cloned.id = 'pr-' + Date.now();
            cloned.title = `[Siklus Lanjutan] ${src.title}`;
            cloned.phase = 1;
            cloned.planning.gcalSynced = false;
            cloned.planning.gdriveGenerated = false;
            cloned.planning.gdriveFolders = [];
            cloned.production = {
                stage: 'pra_produksi',
                preProdChecklist: { kamera: false, audio: false, lighting: false, briefingMeet: false },
                qcChecklist: { visualAudio: false, tonePR: false, brandSafety: false, akurasiData: false },
                revisions: []
            };
            cloned.distribution.published = false;
            cloned.distribution.sentiment = { positive: 0, neutral: 0, negative: 0 };
            cloned.distribution.mentions = 0;
            cloned.evaluation = { kpiActual: 0, auditCause: '', auditNotes: '', actionTaken: '', archived: false };

            appState.items.unshift(cloned);
            saveState();
            showToast('success', 'Siklus Kampanye Berikutnya Dimulai!', `Brief baru "${cloned.title}" dibuat di Fase 1: Riset.`);
            navigateTo('phase1');
            openDetailDrawer(cloned.id, 1);
        }

        /* =====================================================================
           12. VIEW: ARSIP PEMBELAJARAN
           ===================================================================== */
        function renderArchive(container) {
            container.innerHTML = `
                <div>
                    <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">
                        <i data-lucide="archive" class="w-4 h-4"></i> Repositori Google Drive
                    </div>
                    <h2 class="text-2xl font-bold tracking-tight">Arsip Data Pembelajaran PR</h2>
                    <p class="text-sm text-slate-500 dark:text-slate-400">Kumpulan insight evaluasi, studi kasus optimasi, dan pembelajaran kampanye PR terdahulu.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    ${appState.archive.length === 0 ? `
                    <div class="md:col-span-2 p-10 rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 text-center text-sm text-slate-500">
                        Belum ada data di arsip pembelajaran. Arsipkan hasil evaluasi dari Fase 5.
                    </div>` : appState.archive.map(arc => `
                    <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs space-y-3">
                        <div class="flex items-center justify-between gap-2">
                            <span class="px-2 py-0.5 text-[11px] font-bold rounded border ${pesoBadgeClass(arc.peso)}">${arc.peso} &bull; ${arc.funnel}</span>
                            <span class="text-xs text-slate-400">Diarsipkan: ${formatDateID(arc.archivedAt)}</span>
                        </div>
                        <h4 class="font-bold text-base">${escapeHtml(arc.title)}</h4>
                        <div class="text-xs text-slate-500">${escapeHtml(arc.campaign)}</div>
                        <div class="flex items-center gap-4 text-xs font-semibold pt-1">
                            <span class="text-brand-600 dark:text-brand-400">KPI: ${escapeHtml(arc.kpiSummary)}</span>
                            <span class="text-emerald-600 dark:text-emerald-400">Sentimen +: ${arc.sentimentPositive}%</span>
                        </div>
                        <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-950/60 text-xs text-slate-700 dark:text-slate-300 leading-relaxed">
                            <strong class="block text-slate-900 dark:text-white mb-1">Key Learning / Insight:</strong>
                            ${escapeHtml(arc.keyLearning)}
                        </div>
                    </div>`).join('')}
                </div>
            `;
        }

        /* =====================================================================
           13. SLIDE-OVER DRAWER: EDITOR LINTAS 5 FASE
           ===================================================================== */
        function openDetailDrawer(itemId, tabPhase) {
            const item = appState.items.find(i => i.id === itemId);
            if (!item) return;

            activeDetailId = itemId;
            activeDrawerTab = tabPhase || item.phase || 1;

            document.getElementById('detail-drawer-backdrop').classList.remove('hidden');
            document.getElementById('detail-drawer').classList.remove('translate-x-full');
            renderDrawerContent();
        }

        function closeDetailDrawer() {
            activeDetailId = null;
            document.getElementById('detail-drawer-backdrop').classList.add('hidden');
            document.getElementById('detail-drawer').classList.add('translate-x-full');
        }

        function switchDrawerTab(tab) {
            activeDrawerTab = tab;
            renderDrawerContent();
        }

        function renderDrawerContent() {
            const item = appState.items.find(i => i.id === activeDetailId);
            if (!item) return;

            // Header
            document.getElementById('drawer-header').innerHTML = `
                <div class="min-w-0">
                    <div class="flex items-center gap-2">
                        <span class="px-2 py-0.5 text-[10px] font-bold rounded border ${pesoBadgeClass(item.research.peso)}">${item.research.peso}</span>
