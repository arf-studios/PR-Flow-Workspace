                                <div class="flex items-start justify-between gap-2">
                                    <div>
                                        <span class="px-2.5 py-0.5 text-[11px] font-bold rounded-full ${isUnderKPI ? 'bg-rose-100 text-rose-700 dark:bg-rose-950 dark:text-rose-300' : 'bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300'}">
                                            ${isUnderKPI ? '⚠ Di Bawah KPI / Butuh Optimasi' : '✓ Sesuai Target KPI'}
                                        </span>
                                        <h4 class="font-bold text-base mt-1.5">${escapeHtml(item.title)}</h4>
                                        <p class="text-xs text-slate-500">${escapeHtml(item.research.kpiMetric)}: <strong>${actual.toLocaleString('id-ID')}</strong> / ${target.toLocaleString('id-ID')} (${pct}%)</p>
